<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Start Sports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/super-admin.css">
</head>
<body>
<%- include('../partials/sidebar', {
    adminType: 'SUPER ADMIN',
    currentPage: 'logs',
    logoutUrl: '/auth/logout',
    loginUrl: '/auth/login'
}) %>

<main class="sa-main">
    <div class="sa-topbar">
        <div class="page-title">
            <h1>Activity Logs</h1>
            <p>Showing <%= logs.length %> of <%= total %> total log entries</p>
        </div>
        <div class="admin-badge"><i class="bi bi-shield-lock-fill"></i><span>Super Admin</span></div>
    </div>

    <div class="section-card">
        <div class="filters-bar">
            <select class="filter-select" id="tenantFilter" onchange="applyFilters()">
                <option value="all" <%= !filters.tenant_id || filters.tenant_id==='all' ? 'selected':'' %>>All Tenants</option>
                <% tenants.forEach(t => { %>
                <option value="<%= t.id %>" <%= filters.tenant_id == t.id ? 'selected':'' %>><%= t.business_name %></option>
                <% }) %>
            </select>
            <select class="filter-select" id="actionFilter" onchange="applyFilters()">
                <option value="all" <%= !filters.action || filters.action==='all' ? 'selected':'' %>>All Actions</option>
                <% actionTypes.forEach(a => { %>
                <option value="<%= a %>" <%= filters.action === a ? 'selected':'' %>><%= a %></option>
                <% }) %>
            </select>
            <input type="text" class="filter-input" id="searchInput" placeholder="Search description..." value="<%= filters.search || '' %>">
            <button class="btn btn-ghost" onclick="applyFilters()"><i class="bi bi-search"></i> Search</button>
            <% if (filters.tenant_id || filters.action || filters.search) { %>
            <a href="/super-admin/logs" class="btn btn-ghost"><i class="bi bi-x"></i> Clear</a>
            <% } %>
        </div>

        <% if (logs.length === 0) { %>
        <div class="empty-state"><i class="bi bi-journal-x"></i><p>No log entries found</p></div>
        <% } else { %>
        <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Time</th><th>Role</th><th>User</th><th>Tenant</th><th>Action</th><th>Description</th><th>IP</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(l => { %>
                <tr>
                    <td style="font-size:11px;color:var(--text-2);white-space:nowrap">
                        <%= new Date(l.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %>
                        <br><span style="color:var(--text-3)"><%= new Date(l.created_at).toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit'}) %></span>
                    </td>
                    <td>
                        <span class="role-badge role-<%= l.role === 'super_admin' ? 'super' : l.role === 'system' ? 'system' : 'admin' %>">
                            <%= l.role === 'super_admin' ? 'Super' : l.role %>
                        </span>
                    </td>
                    <td>
                        <div style="font-weight:500;font-size:13px"><%= l.user_name || 'System' %></div>
                        <div style="font-size:11px;color:var(--text-3)"><%= l.user_email || '' %></div>
                    </td>
                    <td style="font-size:12px">
                        <% if (l.business_name) { %>
                        <a href="/super-admin/tenants/<%= l.tenant_id %>" style="color:var(--accent)"><%= l.business_name %></a>
                        <% } else { %>—<% } %>
                    </td>
                    <td><span class="action-chip"><%= l.action %></span></td>
                    <td style="color:var(--text-2);max-width:260px;font-size:12.5px">
                        <%= l.description || '—' %>
                        <% if (l.entity && l.entity_id) { %><div style="font-size:11px;color:var(--text-3);margin-top:2px"><%= l.entity %> #<%= l.entity_id %></div><% } %>
                    </td>
                    <td style="font-size:11px;color:var(--text-3)"><%= l.ip_address || '—' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
        </div>

        <%
            const totalPages = Math.ceil(total / limit);
            const currentPage = page;
        %>
        <% if (totalPages > 1) { %>
        <div class="pagination">
            <% if (currentPage > 1) { %>
            <a href="?<%= new URLSearchParams({...filters, page: currentPage-1}).toString() %>" class="page-btn"><i class="bi bi-chevron-left"></i></a>
            <% } %>
            <% for (let i = Math.max(1, currentPage-2); i <= Math.min(totalPages, currentPage+2); i++) { %>
            <a href="?<%= new URLSearchParams({...filters, page: i}).toString() %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if (currentPage < totalPages) { %>
            <a href="?<%= new URLSearchParams({...filters, page: currentPage+1}).toString() %>" class="page-btn"><i class="bi bi-chevron-right"></i></a>
            <% } %>
        </div>
        <% } %>
        <% } %>
    </div>
</main>

<script>
function getCsrfToken() { const m = document.cookie.match(/(?:^|; )csrf_token=([^;]*)/); return m ? decodeURIComponent(m[1]) : ''; }
function applyFilters() {
    const params = new URLSearchParams();
    const t = document.getElementById('tenantFilter').value, a = document.getElementById('actionFilter').value, q = document.getElementById('searchInput').value.trim();
    if (t && t !== 'all') params.set('tenant_id', t); if (a && a !== 'all') params.set('action', a); if (q) params.set('search', q);
    window.location.href = '/super-admin/logs?' + params.toString();
}
document.getElementById('searchInput').addEventListener('keydown', e => { if (e.key === 'Enter') applyFilters(); });
</script>

<script>
// ── Super Admin Keep-Alive ──────────────────────────────────────
// Pings /super-admin/keepalive every 10 minutes so the sa_access_token
// cookie keeps sliding and the session doesn't expire while you are
// working in another browser tab (e.g. the normal admin panel).
(function() {
    function ping() {
        fetch('/super-admin/keepalive', { method: 'GET', credentials: 'same-origin' })
            .catch(function() {}); // silent fail — just a background heartbeat
    }
    ping(); // ping immediately on page load
    setInterval(ping, 10 * 60 * 1000); // then every 10 minutes
})();
</script>
</body>
</html>
