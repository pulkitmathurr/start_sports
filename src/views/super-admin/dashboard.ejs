<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Start Sports</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="/css/super-admin.css">
</head>
<body>
    <%- include('../partials/sidebar', { 
        adminType: 'SUPER ADMIN',
        currentPage: 'dashboard',
        logoutUrl: '/auth/logout',
        loginUrl: '/auth/login'
    }) %>

    <main class="sa-main">
        <div class="sa-topbar">
            <div class="page-title">
                <h1>Platform Dashboard</h1>
                <p>Overview of all partners, revenue, and activity</p>
            </div>
            <div class="topbar-right">
                <div class="admin-badge"><i class="bi bi-shield-lock-fill"></i><span>Super Admin</span></div>
            </div>
        </div>

        <!-- Modern Compact Stat Cards -->
        <div class="stat-grid">
            <div class="stat-card modern-card" data-accent="blue">
                <div class="stat-icon stat-icon-blue"><i class="bi bi-building"></i></div>
                <div class="stat-label">Total Partners</div>
                <div class="stat-value value-blue"><%= data.stats.total_tenants %></div>
                <div class="stat-sub"><%= data.stats.active_tenants %> active</div>
            </div>
            <div class="stat-card modern-card" data-accent="yellow">
                <div class="stat-icon stat-icon-yellow"><i class="bi bi-currency-rupee"></i></div>
                <div class="stat-label">Platform Revenue</div>
                <div class="stat-value value-yellow">₹<%= Number(data.revenue.total_revenue).toLocaleString('en-IN') %></div>
                <div class="stat-sub">₹<%= Number(data.revenue.this_month_revenue).toLocaleString('en-IN') %> this month</div>
            </div>
            <div class="stat-card modern-card" data-accent="red">
                <div class="stat-icon stat-icon-red"><i class="bi bi-people"></i></div>
                <div class="stat-label">Paying Partners</div>
                <div class="stat-value value-red"><%= data.revenue.paying_tenants %></div>
                <div class="stat-sub"><%= data.stats.trial_tenants %> on free trial</div>
            </div>
            <div class="stat-card modern-card" data-accent="black">
                <div class="stat-icon stat-icon-black"><i class="bi bi-ban"></i></div>
                <div class="stat-label">Suspended / Expired</div>
                <div class="stat-value value-black"><%= data.stats.suspended_tenants %> / <%= data.stats.expired_tenants %></div>
                <div class="stat-sub">Need attention</div>
            </div>
        </div>
        
        <!-- Chart + Plan Breakdown -->
        <div class="grid-3">
            <div class="section-card modern-panel">
                <div class="section-header">
                    <h3><i class="bi bi-graph-up"></i> New Signups (12 months)</h3>
                </div>
                <canvas id="signupChart" height="100"></canvas>
            </div>
            <div class="section-card modern-panel">
                <div class="section-header">
                    <h3><i class="bi bi-pie-chart"></i> By Plan</h3>
                </div>
                <% const maxCount = Math.max(...data.planBreakdown.map(p => p.tenant_count), 1); %>
                <% data.planBreakdown.forEach(p => { %>
                <div class="plan-item">
                    <span class="plan-name-text"><%= p.plan_name %></span>
                    <div class="plan-bar-container">
                        <div class="plan-bar" style="width: <%= Math.round((p.tenant_count/maxCount)*100) %>%"></div>
                    </div>
                    <span class="plan-count"><%= p.tenant_count %></span>
                </div>
                <% }) %>
            </div>
        </div>

        <!-- Recent Tenants + Expiring Soon -->
        <div class="grid-2">
            <div class="section-card modern-panel">
                <div class="section-header">
                    <h3><i class="bi bi-clock-history"></i> Recently Joined</h3>
                </div>
                <table class="tenant-table modern-table">
                    <thead>
                        <tr>
                            <th>Business</th>
                            <th>Plan</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% data.recentTenants.forEach(t => { %>
                        <tr>
                            <td>
                                <div class="tenant-cell">
                                    <div class="tenant-initial"><%= t.business_name.charAt(0).toUpperCase() %></div>
                                    <div>
                                        <div class="tenant-name-text"><%= t.business_name %></div>
                                        <div class="tenant-email-text"><%= t.email %></div>
                                    </div>
                                </div>
                            </td>
                            <td class="plan-cell"><%= t.plan_name || '—' %></td>
                            <td>
                                <% if (t.sub_status === 'active' && t.billing_cycle === 'trial') { %>
                                    <span class="badge badge-trial modern-badge">Trial</span>
                                <% } else if (t.status === 'suspended') { %>
                                    <span class="badge badge-suspended modern-badge">Suspended</span>
                                <% } else if (t.sub_status === 'active') { %>
                                    <span class="badge badge-active modern-badge">Active</span>
                                <% } else { %>
                                    <span class="badge badge-expired modern-badge">Expired</span>
                                <% } %>
                            </td>
                            <td><a href="/super-admin/tenants/<%= t.id %>" class="btn-view minimal-btn"><i class="bi bi-eye"></i> View</a></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
                <a href="/super-admin/tenants" class="view-all-link">View all partners <i class="bi bi-arrow-right"></i></a>
            </div>

            <div class="section-card modern-panel">
                <div class="section-header">
                    <h3><i class="bi bi-alarm"></i> Expiring Soon</h3>
                </div>
                <% if (data.expiringTenants.length === 0) { %>
                    <div class="empty-state modern-empty">
                        <i class="bi bi-check-circle"></i>
                        <p>No subscriptions expiring in 7 days</p>
                    </div>
                <% } else { %>
                    <% data.expiringTenants.forEach(t => { %>
                    <div class="expiring-item modern-expiry-item">
                        <div>
                            <div class="expiry-business"><%= t.business_name %></div>
                            <div class="expiry-meta"><%= t.plan_name %> · <%= t.email %></div>
                        </div>
                        <div class="expiry-right">
                            <span class="days-badge <%= t.days_left <= 1 ? 'days-1' : t.days_left <= 3 ? 'days-3' : 'days-7' %>">
                                <%= t.days_left === 0 ? 'Today' : t.days_left + 'd left' %>
                            </span>
                            <div class="expiry-action"><a href="/super-admin/tenants/<%= t.id %>" class="btn-view minimal-btn small">View</a></div>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </main>

<script>
(function() {
    function ping() {
        fetch('/super-admin/keepalive', { method: 'GET', credentials: 'same-origin' })
            .catch(function() {});
    }
    ping();
    setInterval(ping, 10 * 60 * 1000);
})();
(function () {
    const raw = <%- JSON.stringify(data.signupTrend) %>;
    const labels = raw.map(function (r) {
        const d = new Date(r.month + '-01');
        return d.toLocaleDateString('en-IN', { month: 'short', year: '2-digit' });
    });
    const counts = raw.map(function (r) { return r.count; });
    const ctx = document.getElementById('signupChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'New Signups',
                data: counts,
                backgroundColor: 'rgba(30, 58, 138, 0.2)',
                borderColor: '#1e3a8a',
                borderWidth: 1.5,
                borderRadius: 6,
                borderSkipped: false
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1, precision: 0, font: { size: 10 } }, grid: { color: 'rgba(0,0,0,0.04)' } },
                       x: { ticks: { font: { size: 10 } }, grid: { display: false } } }
        }
    });
})();
</script>
</body>
</html>