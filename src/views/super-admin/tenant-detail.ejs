<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Start Sports</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { background: #0f1923; color: #fff; }
        .sa-sidebar { width: 220px; min-height: 100vh; background: #1a2332; border-right: 1px solid rgba(255,255,255,0.07); position: fixed; top: 0; left: 0; display: flex; flex-direction: column; padding: 28px 0; }
        .sa-logo { font-family: 'Rajdhani', sans-serif; font-size: 20px; font-weight: 700; color: #fff; padding: 0 24px 24px; border-bottom: 1px solid rgba(255,255,255,0.07); }
        .sa-logo span { color: #f39c12; font-size: 11px; display: block; }
        .sa-nav a { display: flex; align-items: center; gap: 10px; padding: 10px 24px; color: rgba(255,255,255,0.55); text-decoration: none; font-size: 14px; transition: all 0.2s; border-left: 3px solid transparent; }
        .sa-nav a:hover, .sa-nav a.active { color: #fff; background: rgba(255,255,255,0.05); border-left-color: #f39c12; }
        .sa-main { margin-left: 220px; padding: 32px; }

        .info-card { background: #1a2332; border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 24px; margin-bottom: 20px; }
        .info-card h3 { font-size: 15px; font-weight: 600; color: rgba(255,255,255,0.6); margin-bottom: 16px; text-transform: uppercase; letter-spacing: 0.5px; font-size: 12px; }

        .info-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
        .info-row:last-child { border-bottom: none; }
        .info-label { font-size: 13px; color: rgba(255,255,255,0.45); }
        .info-value { font-size: 14px; color: rgba(255,255,255,0.85); font-weight: 500; }

        .stat-mini { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 20px; }
        .stat-mini-card { background: #1a2332; border: 1px solid rgba(255,255,255,0.07); border-radius: 10px; padding: 16px; text-align: center; }
        .stat-mini-card .v { font-size: 24px; font-weight: 700; font-family: 'Rajdhani', sans-serif; }
        .stat-mini-card .l { font-size: 11px; color: rgba(255,255,255,0.4); margin-top: 4px; }

        .action-btn { border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 9px 18px; font-size: 13px; cursor: pointer; background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.8); transition: all 0.2s; margin-right: 8px; margin-bottom: 8px; }
        .action-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }
        .action-btn.green  { border-color: rgba(46,204,113,0.4); color: #2ecc71; }
        .action-btn.red    { border-color: rgba(231,76,60,0.4);  color: #e74c3c; }
        .action-btn.yellow { border-color: rgba(243,156,18,0.4); color: #f39c12; }

        .badge { border-radius: 20px; padding: 3px 12px; font-size: 12px; font-weight: 600; }
        .badge-active    { background: rgba(46,204,113,0.15); color: #2ecc71; }
        .badge-trial     { background: rgba(52,152,219,0.15); color: #3498db; }
        .badge-suspended { background: rgba(231,76,60,0.15);  color: #e74c3c; }
        .badge-expired   { background: rgba(149,165,166,0.15); color: #95a5a6; }

        .form-control { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; padding: 8px 12px; font-size: 13px; }
        .form-control:focus { outline: none; border-color: #f39c12; background: rgba(255,255,255,0.08); }
        .form-control option { background: #1a2332; }

        .toast-msg { position: fixed; bottom: 24px; right: 24px; background: #1a2332; border: 1px solid rgba(46,204,113,0.4); color: #2ecc71; border-radius: 8px; padding: 12px 20px; font-size: 14px; display: none; z-index: 9999; }
    </style>
</head>
<body>

<div class="sa-sidebar">
    <div class="sa-logo">START SPORTS<span>SUPER ADMIN</span></div>
    <nav class="sa-nav">
        <a href="/super-admin/dashboard">📊 Dashboard</a>
        <a href="/super-admin/tenants" class="active">🏢 Tenants</a>
        <a href="/auth/logout" onclick="doLogout(event)">🚪 Logout</a>
    </nav>
</div>

<div class="sa-main">

    <!-- Back + Title -->
    <div style="display:flex;align-items:center;gap:16px;margin-bottom:28px">
        <a href="/super-admin/tenants" style="color:rgba(255,255,255,0.4);text-decoration:none;font-size:13px">← Back</a>
        <h1 style="font-family:'Rajdhani',sans-serif;font-size:26px;margin:0"><%= data.tenant.business_name %></h1>
        <% if (data.tenant.status === 'suspended') { %>
            <span class="badge badge-suspended">Suspended</span>
        <% } else if (data.tenant.sub_status === 'active' && data.tenant.billing_cycle === 'trial') { %>
            <span class="badge badge-trial">Trial</span>
        <% } else if (data.tenant.sub_status === 'active') { %>
            <span class="badge badge-active">Active</span>
        <% } else { %>
            <span class="badge badge-expired">Expired</span>
        <% } %>
    </div>

    <!-- Mini stats -->
    <div class="stat-mini">
        <div class="stat-mini-card">
            <div class="v" style="color:#3498db"><%= data.tenant.total_bookings %></div>
            <div class="l">Total Bookings</div>
        </div>
        <div class="stat-mini-card">
            <div class="v" style="color:#2ecc71"><%= data.tenant.total_grounds %></div>
            <div class="l">Grounds</div>
        </div>
        <div class="stat-mini-card">
            <div class="v" style="color:#9b59b6"><%= data.tenant.total_customers %></div>
            <div class="l">Customers</div>
        </div>
        <div class="stat-mini-card">
            <div class="v" style="color:#f39c12">₹<%= Number(data.tenant.total_revenue || 0).toLocaleString('en-IN') %></div>
            <div class="l">Their Revenue</div>
        </div>
    </div>

    <div class="row">
        <div class="col-6">
            <!-- Owner Info -->
            <div class="info-card">
                <h3>Owner Details</h3>
                <div class="info-row"><span class="info-label">Name</span><span class="info-value"><%= data.tenant.owner_name %></span></div>
                <div class="info-row"><span class="info-label">Email</span><span class="info-value"><%= data.tenant.email %></span></div>
                <div class="info-row"><span class="info-label">Phone</span><span class="info-value"><%= data.tenant.phone || '—' %></span></div>
                <div class="info-row"><span class="info-label">City</span><span class="info-value"><%= data.tenant.city || '—' %></span></div>
                <div class="info-row"><span class="info-label">Joined</span><span class="info-value"><%= new Date(data.tenant.created_at).toLocaleDateString('en-IN') %></span></div>
            </div>

            <!-- Subscription Info -->
            <div class="info-card">
                <h3>Subscription</h3>
                <div class="info-row"><span class="info-label">Plan</span><span class="info-value"><%= data.tenant.plan_name || '—' %></span></div>
                <div class="info-row"><span class="info-label">Billing</span><span class="info-value"><%= data.tenant.billing_cycle || '—' %></span></div>
                <div class="info-row"><span class="info-label">Started</span><span class="info-value"><%= data.tenant.started_at ? new Date(data.tenant.started_at).toLocaleDateString('en-IN') : '—' %></span></div>
                <div class="info-row"><span class="info-label">Expires</span><span class="info-value"><%= data.tenant.expires_at ? new Date(data.tenant.expires_at).toLocaleDateString('en-IN') : '—' %></span></div>
                <div class="info-row"><span class="info-label">Amount Paid</span><span class="info-value" style="color:#2ecc71">₹<%= Number(data.tenant.amount_paid || 0).toLocaleString('en-IN') %></span></div>
            </div>
        </div>

        <div class="col-6">
            <!-- Actions -->
            <div class="info-card">
                <h3>Actions</h3>

                <!-- Activate / Suspend -->
                <div style="margin-bottom:20px">
                    <% if (data.tenant.status === 'active') { %>
                    <button class="action-btn red" onclick="doAction('/super-admin/tenants/<%= data.tenant.id %>/suspend', 'Tenant suspended')">Suspend Account</button>
                    <% } else { %>
                    <button class="action-btn green" onclick="doAction('/super-admin/tenants/<%= data.tenant.id %>/activate', 'Tenant activated')">Activate Account</button>
                    <% } %>
                    <button class="action-btn red" onclick="confirmDelete(<%= data.tenant.id %>)">Delete Account</button>
                </div>

                <hr style="border-color:rgba(255,255,255,0.06);margin:16px 0">

                <!-- Extend subscription -->
                <div style="margin-bottom:20px">
                    <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:10px">Extend subscription manually</div>
                    <div style="display:flex;gap:10px;align-items:center">
                        <input type="number" id="extendDays" class="form-control" placeholder="Days" min="1" max="365" style="width:100px">
                        <button class="action-btn yellow" onclick="extendSub(<%= data.tenant.id %>)">Extend</button>
                    </div>
                </div>

                <hr style="border-color:rgba(255,255,255,0.06);margin:16px 0">

                <!-- Change plan -->
                <div>
                    <div style="font-size:13px;color:rgba(255,255,255,0.5);margin-bottom:10px">Change plan</div>
                    <div style="display:flex;gap:10px;align-items:center">
                        <select id="planSelect" class="form-control" style="flex:1">
                            <% plans.forEach(p => { %>
                            <option value="<%= p.id %>" <%= data.tenant.plan_id == p.id ? 'selected' : '' %>><%= p.name %> — ₹<%= p.price_monthly %>/mo</option>
                            <% }) %>
                        </select>
                        <button class="action-btn yellow" onclick="changePlan(<%= data.tenant.id %>)">Change</button>
                    </div>
                </div>
            </div>

            <!-- Sub history -->
            <div class="info-card">
                <h3>Subscription History</h3>
                <% data.subHistory.forEach(s => { %>
                <div class="info-row">
                    <span class="info-label"><%= s.plan_name %> · <%= s.billing_cycle %></span>
                    <span class="info-value" style="font-size:12px">
                        <%= new Date(s.started_at).toLocaleDateString('en-IN') %> →
                        <%= new Date(s.expires_at).toLocaleDateString('en-IN') %>
                        <span class="badge <%= s.status === 'active' ? 'badge-active' : 'badge-expired' %>" style="margin-left:6px"><%= s.status %></span>
                    </span>
                </div>
                <% }) %>
                <% if (!data.subHistory.length) { %>
                <p style="color:rgba(255,255,255,0.3);font-size:13px">No history</p>
                <% } %>
            </div>
        </div>
    </div>

</div>

<div class="toast-msg" id="toast"></div>

<script>
const tenantId = <%= data.tenant.id %>;

function showToast(msg, isError = false) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    t.style.borderColor = isError ? 'rgba(231,76,60,0.4)' : 'rgba(46,204,113,0.4)';
    t.style.color = isError ? '#e74c3c' : '#2ecc71';
    setTimeout(() => t.style.display = 'none', 3000);
}

async function doAction(url, successMsg, body = {}) {
    try {
        const res  = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) { showToast(successMsg); setTimeout(() => location.reload(), 1200); }
        else showToast(data.message, true);
    } catch { showToast('Something went wrong', true); }
}

function extendSub(id) {
    const days = document.getElementById('extendDays').value;
    if (!days || days < 1) return showToast('Enter valid days', true);
    doAction(`/super-admin/tenants/${id}/extend`, `Subscription extended by ${days} days`, { extra_days: parseInt(days) });
}

function changePlan(id) {
    const plan_id = document.getElementById('planSelect').value;
    doAction(`/super-admin/tenants/${id}/change-plan`, 'Plan updated', { plan_id });
}

function confirmDelete(id) {
    if (confirm('Are you sure? This will soft delete the tenant account.')) {
        doAction(`/super-admin/tenants/${id}/delete`, 'Tenant deleted');
        setTimeout(() => window.location.href = '/super-admin/tenants', 1500);
    }
}

async function doLogout(e) {
    e.preventDefault();
    await fetch('/auth/logout', { method: 'POST' });
    window.location.href = '/auth/login';
}
</script>
</body>
</html>
