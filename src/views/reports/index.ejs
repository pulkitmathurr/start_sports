<%- include('../partials/header') %>

<div class="row settings-page-header">

    <!-- ── Page Header ───────────────────────────── -->
    <div class="col-12 mb-4">
        <div class="rp-header">
            <div class="rp-header__left">
                <div class="rp-header__icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>
                <div>
                    <h4 class="rp-header__title">Reports</h4>
                    <span class="rp-header__sub">
                        <i class="bi bi-calendar3 me-1"></i><%= data.range.from %> → <%= data.range.to %>
                        &nbsp;·&nbsp;
                        <% if (filters.ground_id) { %>
                            <i class="bi bi-geo-alt me-1"></i><%= grounds.find(g => g.id == filters.ground_id)?.name || 'Ground' %>
                        <% } else { %>
                            <i class="bi bi-layers me-1"></i>All Grounds
                        <% } %>
                    </span>
                </div>
            </div>
            <button type="button" class="rp-filter-toggle-btn" onclick="toggleFilters()" id="filter-toggle-btn">
                <i class="bi bi-sliders me-2"></i>Filters
                <% if (filters.ground_id || filters.specific_date || filters.date_from || (filters.preset && filters.preset !== 'this_month')) { %>
                    <span class="rp-filter-dot"></span>
                <% } %>
            </button>
        </div>
    </div>

    <!-- ── Collapsible Filter Panel ──────────────── -->
    <div class="col-12 mb-4 rp-filter-panel" id="filter-panel"
         style="<%= (filters.ground_id || filters.specific_date || filters.date_from || (filters.preset && filters.preset !== 'this_month')) ? '' : 'display:none;' %>">
        <div class="card rp-filter-card">
            <div class="card-body py-3 px-4">
                <form method="GET" action="/reports" id="report-form">
                    <div class="d-flex gap-3 flex-wrap align-items-end">

                        <!-- Period dropdown — backend driven -->
                        <div>
                            <label class="rp-lbl">Time Period</label>
                            <select name="preset" class="rp-select" onchange="clearDatesAndSubmit(this)">
                                <option value="today"          <%= filters.preset === 'today'          ? 'selected' : '' %>>Today</option>
                                <option value="this_week"      <%= filters.preset === 'this_week'      ? 'selected' : '' %>>This Week</option>
                                <option value="this_month"     <%= (!filters.preset || filters.preset === 'this_month') && !filters.date_from && !filters.specific_date ? 'selected' : '' %>>This Month</option>
                                <option value="last_3_months"  <%= filters.preset === 'last_3_months'  ? 'selected' : '' %>>Last 3 Months</option>
                                <option value="last_6_months"  <%= filters.preset === 'last_6_months'  ? 'selected' : '' %>>Last 6 Months</option>
                            </select>
                        </div>

                        <!-- Custom From -->
                        <div>
                            <label class="rp-lbl">From</label>
                            <input type="date" name="date_from" value="<%= filters.date_from || '' %>" class="rp-input">
                        </div>

                        <!-- Custom To -->
                        <div>
                            <label class="rp-lbl">To</label>
                            <input type="date" name="date_to"
                                value="<%= filters.date_to || '' %>"
                                max="<%= new Date().toISOString().split('T')[0] %>"
                                class="rp-input">
                        </div>

                        <!-- Specific Date -->
                        <div>
                            <label class="rp-lbl">Specific Date</label>
                            <input type="date" name="specific_date"
                                value="<%= filters.specific_date || '' %>"
                                max="<%= new Date().toISOString().split('T')[0] %>"
                                class="rp-input">
                        </div>

                        <!-- Ground -->
                        <div>
                            <label class="rp-lbl">Ground</label>
                            <select name="ground_id" class="rp-select" onchange="this.form.submit()">
                                <option value="">All Grounds</option>
                                <% grounds.forEach(g => { %>
                                    <option value="<%= g.id %>" <%= filters.ground_id == g.id ? 'selected' : '' %>><%= g.name %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="rp-apply-btn">
                                <i class="bi bi-arrow-clockwise me-1"></i>Apply
                            </button>
                            <a href="/reports" class="rp-clear-btn">
                                <i class="bi bi-x me-1"></i>Clear
                            </a>
                        </div>

                    </div>
                </form>
            </div>
        </div>
    </div>
<%
    const df = data.range.from;
    const dt = data.range.to;
    const hBase = filters.ground_id ? '/history/' + filters.ground_id : '/history';
    const urlTotalBookings = hBase + '?date_from=' + df + '&date_to=' + dt;
    const urlRevenue       = hBase + '?status=confirmed&date_from=' + df + '&date_to=' + dt;
    const urlPending       = hBase + '?status=confirmed&date_from=' + df + '&date_to=' + dt;
    const urlCancelled     = hBase + '?status=cancelled';
%>
    <!-- ── Stat Cards ─────────────────────────────── -->
    <div class="col-12 mb-4">
        <div class="row g-3">

            <!-- Total Bookings -->
            <div class="col-6 col-md-3">
                <div class="rp-stat rp-stat--1">
                    <div class="rp-stat__top">
                        <div class="rp-stat__label">Total Bookings</div>
                        <div class="rp-stat__icon"><i class="bi bi-calendar-check"></i></div>
                    </div>
                    <div class="rp-stat__val"><%= data.summary.total_bookings || 0 %></div>
                    <div class="rp-stat__bottom">
                        <div class="rp-stat__sub">
                            <i class="bi bi-check-circle-fill"></i>
                            <%= data.summary.confirmed || 0 %> confirmed
                        </div>
                    </div>
                </div>
            </div>

            <!-- Total Revenue -->
            <div class="col-6 col-md-3">
                <div class="rp-stat rp-stat--2">
                    <div class="rp-stat__top">
                        <div class="rp-stat__label">Total Revenue</div>
                        <div class="rp-stat__icon"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                    <div class="rp-stat__val">&#8377;<%= Number(data.summary.total_revenue || 0).toLocaleString("en-IN") %></div>
                    <div class="rp-stat__bottom">
                        <div class="rp-stat__sub">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                            collected
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pending Payments -->
            <div class="col-6 col-md-3">
                <div class="rp-stat rp-stat--3">
                    <div class="rp-stat__top">
                        <div class="rp-stat__label">Pending Payments</div>
                        <div class="rp-stat__icon"><i class="bi bi-hourglass-split"></i></div>
                    </div>
                    <div class="rp-stat__val">&#8377;<%= Number(data.summary.outstanding || 0).toLocaleString("en-IN") %></div>
                    <div class="rp-stat__bottom">
                        <div class="rp-stat__sub">
                            <i class="bi bi-exclamation-circle-fill"></i>
                            balance due
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cancellation Rate -->
            <div class="col-6 col-md-3">
                <div class="rp-stat rp-stat--4">
                    <div class="rp-stat__top">
                        <div class="rp-stat__label">Cancellation Rate</div>
                        <div class="rp-stat__icon"><i class="bi bi-x-circle"></i></div>
                    </div>
                    <div class="rp-stat__val"><%= data.summary.cancellation_rate %>%</div>
                    <div class="rp-stat__bottom">
                        <div class="rp-stat__sub">
                            <i class="bi bi-dash-circle-fill"></i>
                            <%= data.summary.cancelled || 0 %> cancelled
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- ── Revenue Chart + Status Donut ──────────── -->
    <div class="col-12 col-lg-8 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-bar-chart me-2" style="color:#1B4332;"></i>REVENUE
                </span>
                <small style="color:#9ca3af; font-size:0.7rem;">Confirmed bookings only</small>
            </div>
            <div class="card-body" style="padding:16px;">
                <canvas id="revenueChart" style="max-height:260px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-pie-chart me-2" style="color:#1B4332;"></i>BOOKING STATUS
                </span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center" style="padding:16px;">
                <canvas id="statusChart" style="max-height:200px; max-width:200px;"></canvas>
                <div id="status-legend" class="rp-legend mt-3"></div>
            </div>
        </div>
    </div>

    <!-- ── Booking Type + Peak Split ─────────────── -->
    <div class="col-12 col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-diagram-3 me-2" style="color:#1B4332;"></i>BOOKING TYPE
                </span>
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center" style="padding:16px;">
                <canvas id="typeChart" style="max-height:200px; max-width:200px;"></canvas>
                <div id="type-legend" class="rp-legend mt-3"></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-clock me-2" style="color:#1B4332;"></i>PEAK VS OFF-PEAK
                </span>
            </div>
            <div class="card-body" style="padding:16px;">
                <% const peak    = data.peakSplit.find(r => r.slot_type === 'peak')     || { count: 0, revenue: 0 } %>
                <% const offPeak = data.peakSplit.find(r => r.slot_type === 'off_peak') || { count: 0, revenue: 0 } %>
                <% const peakTotal = (peak.count || 0) + (offPeak.count || 0) %>
                <% const peakPct   = peakTotal > 0 ? Math.round((peak.count / peakTotal) * 100) : 0 %>
                <% const offPct    = 100 - peakPct %>
                <div class="rp-peak-row">
                    <div class="rp-peak-item rp-peak-item--peak">
                        <div class="rp-peak-label">Peak Hours</div>
                        <div class="rp-peak-val"><%= peak.count %> bookings</div>
                        <div class="rp-peak-rev">₹<%= Number(peak.revenue || 0).toLocaleString('en-IN') %></div>
                    </div>
                    <div class="rp-peak-item rp-peak-item--off">
                        <div class="rp-peak-label">Off-Peak</div>
                        <div class="rp-peak-val"><%= offPeak.count %> bookings</div>
                        <div class="rp-peak-rev">₹<%= Number(offPeak.revenue || 0).toLocaleString('en-IN') %></div>
                    </div>
                </div>
                <div class="rp-peak-bar-wrap mt-3">
                    <div class="rp-peak-bar">
                        <div class="rp-peak-bar__fill rp-peak-bar__fill--peak" style="width:<%= peakPct %>%;"></div>
                        <div class="rp-peak-bar__fill rp-peak-bar__fill--off"  style="width:<%= offPct %>%;"></div>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span style="font-size:0.68rem; color:#b45309; font-weight:600;"><%= peakPct %>% Peak</span>
                        <span style="font-size:0.68rem; color:#1B4332; font-weight:600;"><%= offPct %>% Off-Peak</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Per Ground Comparison ──────────────────── -->
    <% if (!filters.ground_id) { %>
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-geo-alt me-2" style="color:#1B4332;"></i>PER GROUND COMPARISON
                </span>
            </div>
            <div class="card-body" style="padding:16px;">
                <% if (data.groundComparison.length === 0) { %>
                    <p style="color:#9ca3af; font-size:0.82rem; text-align:center; padding:20px 0;">No data available</p>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table mb-0" style="font-size:0.82rem;">
                        <thead>
                            <tr style="background:#f9fafb;">
                                <th class="bk-th" style="padding:10px 14px;">Ground</th>
                                <th class="bk-th">Total Bookings</th>
                                <th class="bk-th">Confirmed</th>
                                <th class="bk-th">Revenue</th>
                                <th class="bk-th" style="width:200px;">Share</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const maxRev = Math.max(...data.groundComparison.map(g => g.revenue || 0), 1) %>
                            <% data.groundComparison.forEach(g => { %>
                            <tr style="border-bottom:1px solid #f3f4f6;">
                                <td style="padding:10px 14px; font-weight:600; color:#111827;"><%= g.name %></td>
                                <td style="padding:10px 10px; color:#374151;"><%= g.total %></td>
                                <td style="padding:10px 10px;">
                                    <span class="bk-badge bk-badge--green"><%= g.confirmed %></span>
                                </td>
                                <td style="padding:10px 10px; font-weight:600; color:#1B4332;">₹<%= Number(g.revenue || 0).toLocaleString('en-IN') %></td>
                                <td style="padding:10px 10px;">
                                    <div style="background:#f3f4f6; border-radius:4px; height:8px; overflow:hidden;">
                                        <div style="background:linear-gradient(90deg,#1B4332,#4ADE80); height:100%; width:<%= maxRev > 0 ? Math.round((g.revenue / maxRev) * 100) : 0 %>%; border-radius:4px;"></div>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>
    <% } %>

    <!-- ── Outstanding Payments ───────────────────── -->
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; letter-spacing:1px; color:#0f1b0f;">
                    <i class="bi bi-exclamation-circle me-2" style="color:#b45309;"></i>OUTSTANDING PAYMENTS
                </span>
                <span style="font-family:'Rajdhani',sans-serif; font-weight:700; font-size:0.9rem; color:#b45309;">
                    Due: ₹<%= Number(data.outstanding.total_outstanding || 0).toLocaleString('en-IN') %>
                </span>
            </div>
            <div class="card-body p-0">
                <% if (data.outstanding.list.length === 0) { %>
                    <div class="text-center py-4" style="color:#9ca3af;">
                        <i class="bi bi-check-circle" style="font-size:1.8rem; color:#4ADE80;"></i>
                        <p class="mt-2 mb-0" style="font-size:0.85rem;">No outstanding payments</p>
                    </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.8rem; white-space:nowrap;">
                        <thead>
                            <tr style="background:#fffbeb;">
                                <th class="bk-th" style="padding:10px 14px;">Booking No.</th>
                                <th class="bk-th">Customer</th>
                                <th class="bk-th">Ground</th>
                                <th class="bk-th">Date</th>
                                <th class="bk-th">Total</th>
                                <th class="bk-th">Paid</th>
                                <th class="bk-th" style="color:#b45309;">Balance Due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% data.outstanding.list.forEach(b => { %>
                            <tr style="border-bottom:1px solid #f3f4f6;">
                                <td style="padding:10px 14px; font-family:'Rajdhani',sans-serif; font-weight:600; color:#1B4332;">
                                    <a href="/bookings/<%= b.id %>" style="color:#1B4332; text-decoration:none;"><%= b.booking_no %></a>
                                </td>
                                <td style="padding:10px 10px;">
                                    <div style="font-weight:500; color:#111827;"><%= b.customer_name %></div>
                                    <div style="font-size:0.7rem; color:#9ca3af;"><%= b.customer_phone %></div>
                                </td>
                                <td style="padding:10px 10px; color:#374151;"><%= b.ground_name || '—' %></td>
                                <td style="padding:10px 10px; color:#374151;"><%= new Date(b.slot_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></td>
                                <td style="padding:10px 10px; color:#374151;">₹<%= b.total_amount %></td>
                                <td style="padding:10px 10px; color:#374151;">₹<%= b.advance_amount %></td>
                                <td style="padding:10px 10px; font-weight:700; color:#b45309;">₹<%= b.balance_amount %></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
// ── Filter panel toggle ───────────────────────────
function toggleFilters() {
    const panel = document.getElementById('filter-panel');
    const btn   = document.getElementById('filter-toggle-btn');
    const shown = panel.style.display !== 'none';
    if (shown) {
        panel.style.display = 'none';
        btn.classList.remove('active');
    } else {
        panel.style.display = 'block';
        btn.classList.add('active');
    }
}
document.addEventListener('DOMContentLoaded', () => {
    const panel = document.getElementById('filter-panel');
    if (panel.style.display !== 'none') {
        document.getElementById('filter-toggle-btn').classList.add('active');
    }
});

// ── Preset selected — clear custom dates then submit ──
function clearDatesAndSubmit(sel) {
    const form = sel.closest('form');
    form.querySelector('[name="date_from"]').value     = '';
    form.querySelector('[name="date_to"]').value       = '';
    form.querySelector('[name="specific_date"]').value = '';
    form.submit();
}

// ── Chart data ────────────────────────────────────
const revenueData = <%- JSON.stringify(data.revenueChart) %>;
const statusData  = <%- JSON.stringify(data.statusBreakdown) %>;
const typeData    = <%- JSON.stringify(data.typeBreakdown) %>;

// ── Revenue Bar Chart ─────────────────────────────
new Chart(document.getElementById('revenueChart').getContext('2d'), {
    type: 'bar',
    data: {
        labels: revenueData.map(r => new Date(r.date + 'T00:00:00').toLocaleDateString('en-IN', { day:'2-digit', month:'short' })),
        datasets: [{ label: 'Revenue (₹)', data: revenueData.map(r => r.revenue),
            backgroundColor: 'rgba(27,67,50,0.75)', borderRadius: 5, borderSkipped: false }]
    },
    options: {
        responsive: true, maintainAspectRatio: true,
        plugins: { legend: { display: false }, tooltip: { callbacks: {
            label: ctx => ' ₹' + Number(ctx.raw).toLocaleString('en-IN') + '  ·  ' + (revenueData[ctx.dataIndex]?.bookings || 0) + ' bookings'
        }}},
        scales: {
            x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#9ca3af' } },
            y: { grid: { color: '#f3f4f6' }, ticks: { font: { size: 10 }, color: '#9ca3af',
                callback: v => '₹' + Number(v).toLocaleString('en-IN') }}
        }
    }
});

// ── Status Donut ──────────────────────────────────
const statusColors = { confirmed:'#1B4332', pending:'#f59e0b', cancelled:'#ef4444', expired:'#9ca3af', rejected:'#f87171', approved:'#3b82f6', completed:'#2D6A4F' };
new Chart(document.getElementById('statusChart').getContext('2d'), {
    type: 'doughnut',
    data: { labels: statusData.map(r => r.status),
        datasets: [{ data: statusData.map(r => r.count), backgroundColor: statusData.map(r => statusColors[r.status] || '#9ca3af'), borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }]},
    options: { responsive: true, maintainAspectRatio: true, cutout: '68%',
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ' ' + ctx.label + ': ' + ctx.raw }}}}
});
const statusLegend = document.getElementById('status-legend');
statusData.forEach(r => { statusLegend.innerHTML += `<div class="rp-legend-item"><div class="rp-legend-dot" style="background:${statusColors[r.status]||'#9ca3af'}"></div><span>${r.status} (${r.count})</span></div>`; });

// ── Type Donut ────────────────────────────────────
const typeColors = { online:'#3b82f6', phone:'#f59e0b', walkin:'#1B4332' };
new Chart(document.getElementById('typeChart').getContext('2d'), {
    type: 'doughnut',
    data: { labels: typeData.map(r => r.type),
        datasets: [{ data: typeData.map(r => r.count), backgroundColor: typeData.map(r => typeColors[r.type] || '#9ca3af'), borderWidth: 2, borderColor: '#fff', hoverOffset: 6 }]},
    options: { responsive: true, maintainAspectRatio: true, cutout: '68%',
        plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ' ' + ctx.label + ': ' + ctx.raw }}}}
});
const typeLegend = document.getElementById('type-legend');
typeData.forEach(r => { typeLegend.innerHTML += `<div class="rp-legend-item"><div class="rp-legend-dot" style="background:${typeColors[r.type]||'#9ca3af'}"></div><span style="text-transform:capitalize">${r.type} (${r.count})</span></div>`; });
</script>

<%- include('../partials/footer') %>
