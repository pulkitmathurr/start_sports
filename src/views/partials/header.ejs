<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
    <title>
        <%= title %> - Start Sports
    </title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/startSportLogo1.png">
    <link rel="shortcut icon" href="/images/LogoLogo10.png">

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- DashQuant CSS — local (PEHLE load karo) -->
    <link href="/assets/css/style.css" rel="stylesheet">
    <link href="/assets/css/plugins.css" rel="stylesheet">

    <!-- Our custom CSS — BAAD MEIN load karo taaki override kare -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- Google Fonts — same as login -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <!-- Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/boxicons@2.1.4/css/boxicons.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css">

</head>

<body class="app sidebar-mini ltr light-mode">

    <!-- Loader -->
    <!-- <div id="global-loader">
        <img src="/assets/images/loader.svg" class="loader-img" alt="Loader">
    </div> -->

    <div class="page">
        <div class="page-main">

            <!-- APP HEADER -->
            <div class="app-header header sticky">
                <div class="container-fluid main-container">
                    <div class="d-flex">

                        <a aria-label="Hide Sidebar" class="app-sidebar__toggle" data-bs-toggle="sidebar"
                            href="javascript:void(0)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round"
                                class="feather feather-grid status_toggle middle sidebar-toggle">
                                <rect x="3" y="3" width="7" height="7"></rect>
                                <rect x="14" y="3" width="7" height="7"></rect>
                                <rect x="14" y="14" width="7" height="7"></rect>
                                <rect x="3" y="14" width="7" height="7"></rect>
                            </svg>
                        </a>

                        <!-- Right side: dark mode + profile — always visible -->
                        <div class="d-flex align-items-center gap-2 ms-auto header-right-icons">

                            <!-- Profile -->
                            <div class="dropdown d-flex profile-1">
                                <a href="javascript:void(0)" data-bs-toggle="dropdown" data-bs-offset="0,2"
                                    class="nav-link user-dropdown">
                                    <div class="avatar avatar-md brround cover-image"
                                        style="overflow:hidden; display:flex; align-items:center; justify-content:center;">
                                        <% if (typeof user !=='undefined' && user && user.profile_image) { %>
                                            <img src="/uploads/avatars/<%= user.profile_image %>" alt="<%= user.name %>"
                                                style="width:100%; height:100%; object-fit:cover; border-radius:50%;">
                                            <% } else { %>
                                                <%= typeof user !=='undefined' && user && user.name ?
                                                    user.name.charAt(0).toUpperCase() : 'A' %>
                                                    <% } %>
                                    </div>
                                    <div class="media-body d-lg-block d-none ps-2">
                                        <p class="mb-0">
                                            <%= typeof user !=='undefined' && user && user.name ? user.name : 'Admin' %>
                                        </p>
                                        <p class="mb-0 text-muted" style="font-size:0.75rem;">Administrator</p>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <div class="drop-heading">
                                        <div class="d-flex align-items-center gap-3 px-1">
                                            <!-- Avatar -->
                                            <div style="width:46px; height:46px; border-radius:50%; overflow:hidden; flex-shrink:0;
                    background:linear-gradient(135deg,#1B4332,#39ff14);
                    display:flex; align-items:center; justify-content:center;
                    font-weight:700; font-size:1.1rem; color:#fff;">
                                                <% if (typeof user !=='undefined' && user && user.profile_image) { %>
                                                    <img src="/uploads/avatars/<%= user.profile_image %>"
                                                        alt="<%= user.name %>"
                                                        style="width:100%; height:100%; object-fit:cover;">
                                                    <% } else { %>
                                                        <%= typeof user !=='undefined' && user && user.name ?
                                                            user.name.charAt(0).toUpperCase() : 'A' %>
                                                            <% } %>
                                            </div>
                                            <!-- Name + Role -->
                                            <div>
                                                <h5 class="text-dark mb-0 fs-14 fw-semibold">
                                                    <%= typeof user !=='undefined' && user && user.name ? user.name
                                                        : 'Admin' %>
                                                </h5>
                                                <small class="text-muted">Administrator</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="dropdown-divider m-0"></div>
                                    <a class="dropdown-item" href="/profile">
                                        <i class="dropdown-icon bi bi-person"></i> Profile
                                    </a>
                                    <a class="dropdown-item text-danger" href="#" onclick="logout(); return false;">
                                        <i class="dropdown-icon bi bi-box-arrow-right"></i> Sign out
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <!-- APP HEADER END -->

            <!-- APP SIDEBAR -->
            <div class="sticky">
                <div class="app-sidebar__overlay" data-bs-toggle="sidebar"></div>
                <div class="app-sidebar">
                    <div class="side-header">
                        <a class="header-brand1" href="/dashboard">
                            <!-- Full logo — visible when expanded -->
                            <img src="/images/LogoLogo10.png" alt="SS Logo" class="sidebar-logo sidebar-logo--full"
                                style="height:180px; width:auto; object-fit:contain;">
                            <!-- Mini logo — visible when collapsed -->
                            <img src="/images/startSportLogo1.png" alt="SS" class="sidebar-logo sidebar-logo--mini"
                                style="display:none; height:150px; width:80px; object-fit:contain; border-radius:8px;">
                        </a>
                    </div>

                    <div class="main-sidemenu">
                        <ul class="side-menu">

                            <li class="sub-category">
                                <h3>Main</h3>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/dashboard">
                                    <i class="side-menu__icon bi bi-house"></i>
                                    <span class="side-menu__label">Dashboard</span>
                                </a>
                            </li>

                            <li class="sub-category">
                                <h3>Bookings</h3>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'bookings' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/bookings">
                                    <i class="side-menu__icon bi bi-calendar-check"></i>
                                    <span class="side-menu__label">Today's Bookings</span>
                                </a>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'history' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/history">
                                    <i class="side-menu__icon bi bi-clock-history"></i>
                                    <span class="side-menu__label">History</span>
                                </a>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/customers">
                                    <i class="side-menu__icon bi bi-people"></i>
                                    <span class="side-menu__label">Customers</span>
                                </a>
                            </li>

                            <li class="sub-category">
                                <h3>Financial</h3>
                            </li>

                            <!-- Balance Sheet Menu Item -->
                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'balance' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/balance-sheet/page">
                                    <i class="side-menu__icon bi bi-calculator-fill"></i>
                                    <span class="side-menu__label">Balance Sheet</span>
                                </a>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'expenses' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/expenses/page">
                                    <i class="side-menu__icon bi bi-wallet2"></i>
                                    <span class="side-menu__label">Expense Tracker</span>
                                </a>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'reports' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/reports">
                                    <i class="side-menu__icon bi bi-bar-chart-line"></i>
                                    <span class="side-menu__label">Reports</span>
                                </a>
                            </li>
                            <li class="sub-category">
                                <h3>Admin</h3>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'grounds' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/grounds">
                                    <i class="side-menu__icon bi bi-geo-alt"></i>
                                    <span class="side-menu__label">Manage Grounds</span>
                                </a>
                            </li>

                            <li class="sub-category">
                                <h3>Account</h3>
                            </li>

                            <li
                                class="slide <%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'is-expanded' : '' %>">
                                <a class="sidenav-menu-item" href="/profile">
                                    <i class="side-menu__icon bi bi-person"></i>
                                    <span class="side-menu__label">Profile</span>
                                </a>
                            </li>

                            <li class="slide">
                                <a class="sidenav-menu-item text-danger" href="#" onclick="logout(); return false;">
                                    <i class="side-menu__icon bi bi-box-arrow-right text-danger"></i>
                                    <span class="side-menu__label text-danger">Logout</span>
                                </a>
                            </li>

                        </ul>
                    </div>
                </div>
            </div>
            <!-- APP SIDEBAR END -->

            <!-- PAGE WRAPPER START -->
            <div class="app-content main-content">
                <div class="side-app">
                    <div class="main-container container-fluid">