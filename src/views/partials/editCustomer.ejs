<!-- ── Edit Customer Drawer — Overlay ─────────────────────────── -->
<div id="ec-overlay" onclick="closeEditCustomer()" style="display:none; position:fixed; inset:0;
     background:rgba(0,0,0,0.5); z-index:1040; opacity:0;
     transition:opacity 0.3s ease;"></div>

<!-- ── Edit Customer Drawer — Panel ───────────────────────────── -->
<div id="ec-drawer" style="position:fixed; top:0; right:0; height:100vh; width:440px; max-width:100vw;
     background:#ffffff; border-left:1px solid #DEE2E6;
     box-shadow:-8px 0 32px rgba(0,0,0,0.12); z-index:1050;
     transform:translateX(100%); transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
     display:flex; flex-direction:column; overflow:hidden;">

    <!-- Top green bar -->
    <div style="height:3px; background:linear-gradient(90deg,#1B4332,#4ADE80); flex-shrink:0;"></div>

    <!-- Header -->
    <div style="padding:18px 22px 14px; border-bottom:1px solid #DEE2E6;
                display:flex; align-items:center; justify-content:space-between; flex-shrink:0; background:#fff;">
        <div>
            <div style="font-family:'Rajdhani',sans-serif; font-weight:700;
                        font-size:1.1rem; letter-spacing:2px; color:#1B4332;">
                <i class="bi bi-pencil-square me-2" style="color:#1B4332;"></i>EDIT CUSTOMER
            </div>
            <small style="color:#ADB5BD; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase;">
                Update customer details
            </small>
        </div>
        <button onclick="closeEditCustomer()" style="background:#F8F9FA; border:1px solid #DEE2E6;
               color:#495057; border-radius:8px; width:34px; height:34px; cursor:pointer;
               display:flex; align-items:center; justify-content:center; transition:background 0.2s;"
            onmouseover="this.style.background='#e9ecef'" onmouseout="this.style.background='#F8F9FA'">
            <i class="bi bi-x-lg" style="font-size:0.85rem;"></i>
        </button>
    </div>

    <!-- Body -->
    <div style="flex:1; overflow-y:auto; min-height:0; padding:24px 22px; background:#F8F9FA;">

        <!-- Hidden customer ID -->
        <input type="hidden" id="ec-customer-id">

        <!-- Alert box -->
        <div id="ec-alert" style="display:none; margin-bottom:16px; padding:11px 14px; border-radius:8px;
             font-size:0.82rem; font-weight:500;"></div>

        <!-- Name -->
        <div style="margin-bottom:18px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Full Name <span style="color:#ef4444;">*</span>
            </label>
            <input type="text" id="ec-name" placeholder="Enter Name"
                   style="width:100%; padding:10px 14px; border:1.5px solid #DEE2E6; border-radius:9px;
                          font-size:0.9rem; color:#1a1a1a; background:#fff; box-sizing:border-box;
                          transition:border-color 0.2s;"
                   onfocus="this.style.borderColor='#1B4332'" onblur="this.style.borderColor='#DEE2E6'">
        </div>

        <!-- Phone — Read only -->
        <div style="margin-bottom:18px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Phone Number
            </label>
            <div style="position:relative;">
                <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%);
                             font-size:0.85rem; color:#9CA3AF; font-weight:600; pointer-events:none;"></span>
                <input type="tel" id="ec-phone" readonly
                       style="width:100%; padding:10px 14px 10px 40px; border:1.5px solid #E5E7EB; border-radius:9px;
                              font-size:0.9rem; color:#9CA3AF; background:#F3F4F6; box-sizing:border-box;
                              cursor:not-allowed;">
            </div>
            <small style="color:#9CA3AF; font-size:0.72rem; margin-top:4px; display:block;">
                <i class="bi bi-lock-fill me-1"></i>Phone number cannot be changed
            </small>
        </div>

        <!-- Email -->
        <div style="margin-bottom:18px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Email <span style="color:#ADB5BD; font-weight:400; font-size:0.7rem; text-transform:none;">(optional)</span>
            </label>
            <input type="email" id="ec-email" placeholder="example@gmail.com"
                   style="width:100%; padding:10px 14px; border:1.5px solid #DEE2E6; border-radius:9px;
                          font-size:0.9rem; color:#1a1a1a; background:#fff; box-sizing:border-box;
                          transition:border-color 0.2s;"
                   onfocus="this.style.borderColor='#1B4332'" onblur="this.style.borderColor='#DEE2E6'">
        </div>

        <!-- Address -->
        <div style="margin-bottom:28px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Address <span style="color:#ADB5BD; font-weight:400; font-size:0.7rem; text-transform:none;">(optional)</span>
            </label>
            <textarea id="ec-address" placeholder="e.g. 12, MG Road, Jaipur"
                   rows="3"
                   style="width:100%; padding:10px 14px; border:1.5px solid #DEE2E6; border-radius:9px;
                          font-size:0.9rem; color:#1a1a1a; background:#fff; box-sizing:border-box;
                          transition:border-color 0.2s; resize:vertical; font-family:inherit;"
                   onfocus="this.style.borderColor='#1B4332'" onblur="this.style.borderColor='#DEE2E6'"></textarea>
        </div>

        <!-- Info box -->
        <div style="background:rgba(27,67,50,0.05); border:1px solid rgba(27,67,50,0.15);
                    border-radius:10px; padding:12px 16px; margin-bottom:8px;">
            <div style="font-size:0.78rem; color:#1B4332; font-weight:600; margin-bottom:4px;">
                <i class="bi bi-info-circle me-1"></i> Note
            </div>
            <div style="font-size:0.75rem; color:#4B5563; line-height:1.5;">
                Only <strong>name, email and address</strong> can be edited. Phone number is locked as it is linked to all booking records.
            </div>
        </div>

    </div>

    <!-- Footer -->
    <div style="padding:16px 22px; border-top:1px solid #DEE2E6; background:#fff; flex-shrink:0;">
        <button id="ec-submit-btn" onclick="submitEditCustomer()"
                style="width:100%; padding:12px; background:#1B4332; color:#fff; border:none;
                       border-radius:10px; font-size:0.9rem; font-weight:700; cursor:pointer;
                       letter-spacing:0.5px; transition:background 0.2s; display:flex;
                       align-items:center; justify-content:center; gap:8px;"
                onmouseover="this.style.background='#14532d'" onmouseout="this.style.background='#1B4332'">
            <i class="bi bi-check2-circle"></i> Save Changes
        </button>
    </div>
</div>

<script>
function openEditCustomer(customerId, name, phone, email, address) {
    document.getElementById('ec-customer-id').value = customerId;
    document.getElementById('ec-name').value        = name    || '';
    document.getElementById('ec-phone').value       = phone   || '';
    document.getElementById('ec-email').value       = email   || '';
    document.getElementById('ec-address').value     = address || '';
    document.getElementById('ec-alert').style.display = 'none';

    const btn = document.getElementById('ec-submit-btn');
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check2-circle"></i> Save Changes';
    btn.style.background = '#1B4332';

    document.getElementById('ec-overlay').style.display = 'block';
    requestAnimationFrame(() => {
        document.getElementById('ec-overlay').style.opacity = '1';
        document.getElementById('ec-drawer').style.transform = 'translateX(0)';
    });
    document.getElementById('ec-name').focus();
}

function closeEditCustomer() {
    document.getElementById('ec-overlay').style.opacity = '0';
    document.getElementById('ec-drawer').style.transform = 'translateX(100%)';
    setTimeout(() => {
        document.getElementById('ec-overlay').style.display = 'none';
        document.getElementById('ec-alert').style.display = 'none';
    }, 350);
}

function showEcAlert(msg, type) {
    const el = document.getElementById('ec-alert');
    el.style.display = 'block';
    if (type === 'error') {
        el.style.background = '#FEF2F2';
        el.style.color = '#DC2626';
        el.style.border = '1px solid #FECACA';
        el.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i>${msg}`;
    } else {
        el.style.background = '#F0FDF4';
        el.style.color = '#16A34A';
        el.style.border = '1px solid #BBF7D0';
        el.innerHTML = `<i class="bi bi-check-circle me-1"></i>${msg}`;
    }
}

async function submitEditCustomer() {
    const customerId = document.getElementById('ec-customer-id').value;
    const name       = document.getElementById('ec-name').value.trim();
    const email      = document.getElementById('ec-email').value.trim();
    const address    = document.getElementById('ec-address').value.trim();

    if (!name) { showEcAlert('Please enter the customer name.', 'error'); return; }

    const btn = document.getElementById('ec-submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Saving...';
    btn.style.background = '#374151';

    try {
        const res = await fetch(`/customers/${customerId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, email: email || null, address: address || null })
        });
        const data = await res.json();

        if (data.success) {
            showEcAlert('Customer updated successfully!', 'success');
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Saved!';
            btn.style.background = '#16A34A';
            setTimeout(() => {
                closeEditCustomer();
                window.location.reload();
            }, 1000);
        } else {
            showEcAlert(data.message || 'Failed to update customer.', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check2-circle"></i> Save Changes';
            btn.style.background = '#1B4332';
        }
    } catch (e) {
        showEcAlert('Something went wrong. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2-circle"></i> Save Changes';
        btn.style.background = '#1B4332';
    }
}

document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('ec-overlay').style.display === 'block') {
        closeEditCustomer();
    }
});
</script>
