(function () {
    function ping() {
        fetch('/dashboard', { method: 'GET', headers: { 'Accept': 'application/json' }, credentials: 'same-origin' }).catch(function(){});
    }
    setInterval(ping, 10 * 60 * 1000);
})();
</script>


