<script>
// ── Global Confirm Modal ────────────────────────────────────────
// showDelModal(options, onConfirm)
// options: { title, message, confirmText, cancelText, icon, iconClass, confirmClass }
// OR legacy: showDelModal(nameString, onConfirm) — backward compatible
function showDelModal(optionsOrName, onConfirm) {
    let title = 'Confirm', sub = '', confirmText = 'Confirm', cancelText = 'Cancel';
    let icon = 'bi bi-question-circle-fill', iconClass = 'del-modal__icon--warn', confirmClass = '';

    if (typeof optionsOrName === 'string') {
        // Legacy: showDelModal('booking name', fn)
        title = 'Delete Confirmation';
        sub = `Are you sure you want to delete <strong>${optionsOrName}</strong>? This action cannot be undone.`;
        icon = 'bi bi-trash3-fill';
        iconClass = 'del-modal__icon--danger';
        confirmText = 'Delete';
    } else {
        title       = optionsOrName.title       || title;
        sub         = optionsOrName.message     || sub;
        confirmText = optionsOrName.confirmText || confirmText;
        cancelText  = optionsOrName.cancelText  || cancelText;
        icon        = optionsOrName.icon        || icon;
        iconClass   = optionsOrName.iconClass   || iconClass;
        confirmClass= optionsOrName.confirmClass|| confirmClass;
    }

    document.getElementById('delModalIcon').className = 'del-modal__icon ' + iconClass;
    document.getElementById('delModalIcon').innerHTML = `<i class="${icon}"></i>`;
    document.getElementById('delModalTitle').textContent = title;
    document.getElementById('delModalSub').innerHTML = sub;
    document.getElementById('delModalCancel').textContent = cancelText;
    document.getElementById('delModalConfirm').textContent = confirmText;
    document.getElementById('delModalConfirm').className = 'del-modal__btn del-modal__btn--confirm ' + confirmClass;
    document.getElementById('delModalConfirm').onclick = function() {
        closeDelModal();
        onConfirm();
    };
    document.getElementById('delModalBackdrop').classList.add('open');
}

function closeDelModal(e) {
    if (e && e.target !== document.getElementById('delModalBackdrop')) return;
    document.getElementById('delModalBackdrop').classList.remove('open');
}

// ── Global Input Modal ──────────────────────────────────────────
// showInputModal({ title, message, placeholder, confirmText, icon, iconClass, required }, onConfirm)
function showInputModal(options, onConfirm) {
    const title       = options.title       || 'Enter Details';
    const sub         = options.message     || '';
    const placeholder = options.placeholder || '';
    const confirmText = options.confirmText || 'Confirm';
    const icon        = options.icon        || 'bi bi-pencil-square';
    const iconClass   = options.iconClass   || 'del-modal__icon--info';
    const required    = options.required    !== false;
    const rows        = options.rows        || 3;

    document.getElementById('inputModalIcon').className = 'del-modal__icon ' + iconClass;
    document.getElementById('inputModalIcon').innerHTML = `<i class="${icon}"></i>`;
    document.getElementById('inputModalTitle').textContent = title;
    document.getElementById('inputModalSub').innerHTML = sub;
    document.getElementById('inputModalField').placeholder = placeholder;
    document.getElementById('inputModalField').value = '';
    document.getElementById('inputModalField').rows = rows;
    document.getElementById('inputModalError').style.display = 'none';
    document.getElementById('inputModalConfirm').textContent = confirmText;
    document.getElementById('inputModalConfirm').className = 'del-modal__btn del-modal__btn--confirm';
    document.getElementById('inputModalConfirm').onclick = function() {
        const val = document.getElementById('inputModalField').value.trim();
        if (required && !val) {
            document.getElementById('inputModalError').textContent = 'This field is required';
            document.getElementById('inputModalError').style.display = 'block';
            return;
        }
        closeInputModal();
        onConfirm(val);
    };
    document.getElementById('inputModalBackdrop').classList.add('open');
    setTimeout(() => document.getElementById('inputModalField').focus(), 100);
}

function closeInputModal(e) {
    if (e && e.target !== document.getElementById('inputModalBackdrop')) return;
    document.getElementById('inputModalBackdrop').classList.remove('open');
}

// Close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        document.getElementById('delModalBackdrop').classList.remove('open');
        document.getElementById('inputModalBackdrop').classList.remove('open');
    }
});
