}


// ── Auto-inject CSRF into ALL plain HTML form submissions ─────
// Plain <form method="POST"> cannot set custom headers, so we
// intercept every form submit and inject a hidden _csrf field.
// This fixes CSRF errors on every page without touching any EJS file.
// NOTE: getCsrfToken() is defined in header.ejs — available globally.
document.addEventListener('DOMContentLoaded', function () {
    document.addEventListener('submit', function (e) {
        const form = e.target;
        if (form.tagName !== 'FORM') return;
        if ((form.method || '').toUpperCase() !== 'POST') return;
        // Skip forms already handled by data-csrf-form (they use fetch)
        if (form.hasAttribute('data-csrf-form')) return;
        // Skip if _csrf field already added
        if (form.querySelector('input[name="_csrf"]')) return;

        const token = getCsrfToken();
        if (!token) return;

        const input = document.createElement('input');
        input.type  = 'hidden';
        input.name  = '_csrf';
        input.value = token;
        form.appendChild(input);
        // No need to prevent default — let the form submit normally
    }, true); // capture phase so it runs before any inline onsubmit
});

// NOTE: window.fetch CSRF patch and getCsrfToken() have been moved to
// header.ejs so they are available to all inline scripts (including
// quickbook-drawer.ejs) before those scripts execute.

// ── Logout ─────────────────────────────────────────────────────
// NOTE: window.fetch is already patched in header.ejs to auto-inject
// X-CSRF-Token on every mutating request, so the token is sent
// automatically. This function is the single shared logout handler
// for the regular admin panel (called via onclick="logout(event)").
async function logout(e) {
    if (e) e.preventDefault();
    try {
        await fetch('/auth/logout', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': getCsrfToken()
            }
        });
    } catch(err) { /* proceed to redirect regardless */ }
    window.location.replace('/auth/login');
}
</script>

<!-- ── Peak Suggestion Toast ────────────────────── -->
<div id="peak-suggestion-toast"
     style="display:none; position:fixed; bottom:28px; right:28px; z-index:9999;
            background:#fff; border-radius:16px; padding:0; width:340px;
            box-shadow:0 8px 40px rgba(0,0,0,0.13); border:1px solid #e8f5e9;
