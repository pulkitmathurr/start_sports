            💡 Peak Hours Suggestion
        </span>
        <span id="peak-suggestion-counter"
              style="font-size:11px; color:rgba(255,255,255,0.7);
                     background:rgba(255,255,255,0.15); padding:2px 8px; border-radius:20px;"></span>
    </div>

    <!-- Body -->
    <div style="padding:16px 18px;">
        <!-- Ground name badge -->
        <div style="display:inline-flex; align-items:center; gap:5px;
                    background:#e8f5e9; color:#1a5c38; font-size:12px;
                    font-weight:700; padding:3px 10px; border-radius:20px; margin-bottom:10px;">
            <span>📍</span>
            <span id="peak-suggestion-ground"></span>
        </div>

        <!-- Message -->
        <div id="peak-suggestion-msg"
             style="font-size:13px; color:#444; line-height:1.6; margin-bottom:16px;"></div>

        <!-- Buttons -->
        <div style="display:flex; gap:8px;">
            <button onclick="acceptPeakSuggestion()"
                    style="flex:1; padding:9px; border:none; border-radius:8px;
                           background:linear-gradient(135deg, #1a5c38, #2d7a4f);
                           color:#fff; font-weight:600; font-size:13px; cursor:pointer;
                           box-shadow:0 2px 8px rgba(26,92,56,0.3);">
                ✓ Apply
            </button>
            <button onclick="dismissPeakSuggestion()"
                    style="flex:1; padding:9px; border:1px solid #e0e0e0; border-radius:8px;
                           background:#f5f5f5; color:#666; font-weight:600;
                           font-size:13px; cursor:pointer;">
                Dismiss
            </button>
            <button onclick="nextPeakSuggestion()"
                    id="peak-suggestion-next"
                    style="display:none; padding:9px 12px; border:1px solid #e0e0e0;
                           border-radius:8px; background:#f5f5f5; color:#1a5c38;
                           font-weight:700; font-size:13px; cursor:pointer;">
                Next →
            </button>
        </div>
    </div>
</div>

<script>
(function() {
    const toast     = document.getElementById('peak-suggestion-toast');
    const groundEl  = document.getElementById('peak-suggestion-ground');
    const msgEl     = document.getElementById('peak-suggestion-msg');
    const counterEl = document.getElementById('peak-suggestion-counter');
    const nextBtn   = document.getElementById('peak-suggestion-next');

    let suggestions  = [];
    let currentIndex = 0;

    function showSuggestion(index) {
        if (!suggestions.length) { toast.style.display = 'none'; return; }

        const s = suggestions[index];
        groundEl.textContent = s.ground_name;
        msgEl.textContent =
            `Last 3 months show ${s.suggested_start}–${s.suggested_end} ` +
            `is the busiest slot (${s.booking_count} bookings). Set as peak hours?`;

        if (suggestions.length > 1) {
            counterEl.textContent = `${index + 1} of ${suggestions.length}`;
            nextBtn.style.display = 'inline-block';
        } else {
            counterEl.textContent = '';
            nextBtn.style.display = 'none';
        }

        toast.style.display = 'block';
    }

    async function checkPeakSuggestions() {
        try {
            const res  = await fetch('/settings/peak-suggestion/pending');
            const json = await res.json();
            suggestions  = json.data || [];
            currentIndex = 0;
            showSuggestion(0);
        } catch (e) { /* silent */ }
    }

    window.nextPeakSuggestion = function() {
        currentIndex = (currentIndex + 1) % suggestions.length;
        showSuggestion(currentIndex);
    };

    window.acceptPeakSuggestion = async function() {
        if (!suggestions.length) return;
        const s = suggestions[currentIndex];
        try {
            await fetch(`/settings/${s.ground_id}/peak-suggestion/accept`, { method: 'POST' });
            suggestions.splice(currentIndex, 1);
            if (currentIndex >= suggestions.length) currentIndex = 0;
            showSuggestion(currentIndex);
        } catch (e) { /* silent */ }
    };

    window.dismissPeakSuggestion = async function() {
        if (!suggestions.length) return;
        const s = suggestions[currentIndex];
        try {
            await fetch(`/settings/${s.ground_id}/peak-suggestion/dismiss`, { method: 'POST' });
            suggestions.splice(currentIndex, 1);
            if (currentIndex >= suggestions.length) currentIndex = 0;
            showSuggestion(currentIndex);
        } catch (e) { /* silent */ }
    };

    document.addEventListener('DOMContentLoaded', checkPeakSuggestions);
    setInterval(checkPeakSuggestions, 5 * 60 * 1000);
})();
</script>

