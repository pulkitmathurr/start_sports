// ── Global Toast ───────────────────────────────────────────────
function xToast(msg, type='success') {
    const icons = { success:'check-circle-fill', error:'exclamation-triangle-fill', warning:'exclamation-circle-fill' };
    const t = document.createElement('div');
    t.className = `xtoast ${type}`;
    t.innerHTML = `<i class="bi bi-${icons[type]||icons.success}"></i><span>${msg}</span>`;
