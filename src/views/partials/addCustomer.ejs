<!-- ── Add Customer Drawer — Overlay ──────────────────────────── -->
<div id="ac-overlay" onclick="closeAddCustomer()" style="display:none; position:fixed; inset:0;
     background:rgba(0,0,0,0.5); z-index:1040; opacity:0;
     transition:opacity 0.3s ease;"></div>

<!-- ── Add Customer Drawer — Panel ────────────────────────────── -->
<div id="ac-drawer" style="position:fixed; top:0; right:0; height:100vh; width:440px; max-width:100vw;
     background:#ffffff; border-left:1px solid #DEE2E6;
     box-shadow:-8px 0 32px rgba(0,0,0,0.12); z-index:1050;
     transform:translateX(100%); transition:transform 0.35s cubic-bezier(0.4,0,0.2,1);
     display:flex; flex-direction:column; overflow:hidden;">

    <!-- Top green bar -->
    <div style="height:3px; background:linear-gradient(90deg,#1B4332,#4ADE80); flex-shrink:0;"></div>

    <!-- Header -->
    <div style="padding:18px 22px 14px; border-bottom:1px solid #DEE2E6;
                display:flex; align-items:center; justify-content:space-between; flex-shrink:0; background:#fff;">
        <div>
            <div style="font-family:'Rajdhani',sans-serif; font-weight:700;
                        font-size:1.1rem; letter-spacing:2px; color:#1B4332;">
                <i class="bi bi-person-plus-fill me-2" style="color:#1B4332;"></i>ADD CUSTOMER
            </div>
            <small style="color:#ADB5BD; font-size:0.68rem; letter-spacing:1px; text-transform:uppercase;">
                Create customer profile manually
            </small>
        </div>
        <button onclick="closeAddCustomer()" style="background:#F8F9FA; border:1px solid #DEE2E6;
               color:#495057; border-radius:8px; width:34px; height:34px; cursor:pointer;
               display:flex; align-items:center; justify-content:center; transition:background 0.2s;"
            onmouseover="this.style.background='#e9ecef'" onmouseout="this.style.background='#F8F9FA'">
            <i class="bi bi-x-lg" style="font-size:0.85rem;"></i>
        </button>
    </div>

    <!-- Body -->
    <div style="flex:1; overflow-y:auto; min-height:0; padding:24px 22px; background:#F8F9FA;">

        <!-- Alert box -->
        <div id="ac-alert" style="display:none; margin-bottom:16px; padding:11px 14px; border-radius:8px;
             font-size:0.82rem; font-weight:500;"></div>

        <!-- Name -->
        <div style="margin-bottom:18px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Full Name <span style="color:#ef4444;">*</span>
            </label>
            <input type="text" id="ac-name" placeholder="Enter Name"
                   style="width:100%; padding:10px 14px; border:1.5px solid #DEE2E6; border-radius:9px;
                          font-size:0.9rem; color:#1a1a1a; background:#fff; box-sizing:border-box;
                          transition:border-color 0.2s;"
                   onfocus="this.style.borderColor='#1B4332'" onblur="this.style.borderColor='#DEE2E6'">
        </div>

        <!-- Phone -->
        <!-- Phone -->
<div style="margin-bottom:18px;">
    <label style="display:block; font-size:0.7rem; font-weight:700; color:#475569;
                  letter-spacing:1px; text-transform:uppercase; margin-bottom:6px;">
        Phone Number <span style="color:#f59e0b;">*</span>
    </label>
    <div style="position:relative;">
        <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%);
                     font-size:0.85rem; color:#64748b; font-weight:600; pointer-events:none; z-index:2;"></span>
        <input type="tel" id="ac-phone" placeholder="98765 43210" maxlength="10"
               oninput="this.value=this.value.replace(/\D/g,'')"
               style="width:100%; padding:10px 14px 10px 48px; border:1.5px solid #e2e8f0; border-radius:10px;
                      font-size:0.85rem; color:#1e293b; background:#ffffff; box-sizing:border-box;
                      transition:border-color 0.2s; font-family:'Inter', sans-serif;"
               onfocus="this.style.borderColor='#f59e0b'" onblur="this.style.borderColor='#e2e8f0'">
    </div>
    <small style="color:#94a3b8; font-size:0.68rem; margin-top:5px; display:block;">
        10-digit mobile number — used to search this customer during booking
    </small>
</div>

        <!-- Email -->
        <div style="margin-bottom:28px;">
            <label style="display:block; font-size:0.78rem; font-weight:700; color:#374151;
                          letter-spacing:0.5px; text-transform:uppercase; margin-bottom:6px;">
                Email <span style="color:#ADB5BD; font-weight:400; font-size:0.7rem; text-transform:none;">(optional)</span>
            </label>
            <input type="email" id="ac-email" placeholder="example@gmail.com"
                   style="width:100%; padding:10px 14px; border:1.5px solid #DEE2E6; border-radius:9px;
                          font-size:0.9rem; color:#1a1a1a; background:#fff; box-sizing:border-box;
                          transition:border-color 0.2s;"
                   onfocus="this.style.borderColor='#1B4332'" onblur="this.style.borderColor='#DEE2E6'">
        </div>

        <!-- Info box -->
        <div style="background:rgba(27,67,50,0.05); border:1px solid rgba(27,67,50,0.15);
                    border-radius:10px; padding:12px 16px; margin-bottom:24px;">
            <div style="font-size:0.78rem; color:#1B4332; font-weight:600; margin-bottom:4px;">
                <i class="bi bi-info-circle me-1"></i> How this works
            </div>
            <div style="font-size:0.75rem; color:#4B5563; line-height:1.5;">
                Once created, this customer will appear when you search by name or phone number in the
                <strong>New Booking</strong> form. Their booking history will build automatically.
            </div>
        </div>

    </div>

    <!-- Footer -->
    <div style="padding:16px 22px; border-top:1px solid #DEE2E6; background:#fff; flex-shrink:0;">
        <button id="ac-submit-btn" onclick="submitAddCustomer()"
                style="width:100%; padding:12px; background:#1B4332; color:#fff; border:none;
                       border-radius:10px; font-size:0.9rem; font-weight:700; cursor:pointer;
                       letter-spacing:0.5px; transition:background 0.2s; display:flex;
                       align-items:center; justify-content:center; gap:8px;"
                onmouseover="this.style.background='#14532d'" onmouseout="this.style.background='#1B4332'">
            <i class="bi bi-person-check-fill"></i> Create Customer
        </button>
    </div>
</div>

<script>
function openAddCustomer() {
    document.getElementById('ac-overlay').style.display = 'block';
    requestAnimationFrame(() => {
        document.getElementById('ac-overlay').style.opacity = '1';
        document.getElementById('ac-drawer').style.transform = 'translateX(0)';
    });
    document.getElementById('ac-name').focus();
}

function closeAddCustomer() {
    document.getElementById('ac-overlay').style.opacity = '0';
    document.getElementById('ac-drawer').style.transform = 'translateX(100%)';
    setTimeout(() => {
        document.getElementById('ac-overlay').style.display = 'none';
        // Reset form
        document.getElementById('ac-name').value = '';
        document.getElementById('ac-phone').value = '';
        document.getElementById('ac-email').value = '';
        document.getElementById('ac-alert').style.display = 'none';
        const btn = document.getElementById('ac-submit-btn');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-person-check-fill"></i> Create Customer';
        btn.style.background = '#1B4332';
    }, 350);
}

function showAcAlert(msg, type) {
    const el = document.getElementById('ac-alert');
    el.style.display = 'block';
    if (type === 'error') {
        el.style.background = '#FEF2F2';
        el.style.color = '#DC2626';
        el.style.border = '1px solid #FECACA';
        el.innerHTML = `<i class="bi bi-exclamation-circle me-1"></i>${msg}`;
    } else {
        el.style.background = '#F0FDF4';
        el.style.color = '#16A34A';
        el.style.border = '1px solid #BBF7D0';
        el.innerHTML = `<i class="bi bi-check-circle me-1"></i>${msg}`;
    }
}

async function submitAddCustomer() {
    const name  = document.getElementById('ac-name').value.trim();
    const phone = document.getElementById('ac-phone').value.trim();
    const email = document.getElementById('ac-email').value.trim();

    // Validation
    if (!name) { showAcAlert('Please enter the customer name.', 'error'); return; }
    if (!phone) { showAcAlert('Please enter a phone number.', 'error'); return; }
    if (phone.length !== 10) { showAcAlert('Phone number must be exactly 10 digits.', 'error'); return; }

    const btn = document.getElementById('ac-submit-btn');
    btn.disabled = true;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Creating...';
    btn.style.background = '#374151';

    try {
        const res = await fetch('/customers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, phone: phone, email: email || undefined })
        });
        const data = await res.json();

        if (data.success) {
            showAcAlert(`Customer "${name}" created successfully!`, 'success');
            btn.innerHTML = '<i class="bi bi-check-lg"></i> Created!';
            btn.style.background = '#16A34A';
            // Refresh the customer list after short delay
            setTimeout(() => {
                closeAddCustomer();
                window.location.reload();
            }, 1200);
        } else {
            showAcAlert(data.message || 'Failed to create customer.', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-person-check-fill"></i> Create Customer';
            btn.style.background = '#1B4332';
        }
    } catch (e) {
        showAcAlert('Something went wrong. Please try again.', 'error');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-person-check-fill"></i> Create Customer';
        btn.style.background = '#1B4332';
    }
}

// Close on Escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('ac-overlay').style.display === 'block') {
        closeAddCustomer();
    }
});
</script>
