<script>
// ── CSRF-safe form submission ─────────────────────
function getCsrfToken() {
    const token = document.cookie.split('; ').find(row => row.startsWith('csrf_token='));
    return token ? decodeURIComponent(token.split('=')[1]) : '';
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('form[data-csrf-form]').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const isFileForm = form.enctype === 'multipart/form-data';
            let body, contentTypeHeader;

            if (isFileForm) {
                body = new FormData(form);
                contentTypeHeader = null;
            } else {
                body = new URLSearchParams(new FormData(form));
                contentTypeHeader = 'application/x-www-form-urlencoded';
            }

            const headers = new Headers();
            headers.set('X-CSRF-Token', getCsrfToken());
            if (contentTypeHeader) headers.set('Content-Type', contentTypeHeader);

            const res = await fetch(form.action, { method: 'POST', body, headers });
            if (res.redirected) { window.location.href = res.url; return; }
            if (res.ok) { window.location.reload(); return; }
            try {
                const json = await res.json();
                xToast(json.message || 'Something went wrong', 'error');
            } catch(err) {
                window.location.reload();
            }
        });
    });
});

// ── Avatar preview & auto upload ──────────────────
function previewAndUpload(input) {
    if (!input.files || !input.files[0]) return;

    const file = input.files[0];

    if (file.size > 2 * 1024 * 1024) {
        xToast('Image must be under 2MB', 'error');
        input.value = '';
        return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
        const display = document.getElementById('avatar-display');
        display.innerHTML = `<img src="${e.target.result}" alt="Preview" id="avatar-img">`;
    };
    reader.readAsDataURL(file);

    document.getElementById('avatar-form').dispatchEvent(new Event('submit', { bubbles: true, cancelable: true }));
}

// ── Eye toggle ────────────────────────────────────
function togglePwd(id, icon) {
    const input = document.getElementById(id);
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    icon.classList.toggle('bi-eye-slash', !isHidden);
    icon.classList.toggle('bi-eye', isHidden);
}

// ── Password strength ─────────────────────────────
function checkStrength(pwd) {
    const fill = document.getElementById('strength-fill');
    const text = document.getElementById('strength-text');
    if (!pwd) { fill.style.width = '0%'; text.textContent = ''; return; }

    let score = 0;
    if (pwd.length >= 6)           score++;
    if (pwd.length >= 10)          score++;
    if (/[A-Z]/.test(pwd))         score++;
    if (/[0-9]/.test(pwd))         score++;
    if (/[^A-Za-z0-9]/.test(pwd))  score++;

    const levels = [
        { w: '20%',  bg: '#dc2626', label: 'Very weak'  },
        { w: '40%',  bg: '#f59e0b', label: 'Weak'       },
        { w: '60%',  bg: '#f59e0b', label: 'Fair'       },
        { w: '80%',  bg: '#10b981', label: 'Strong'     },
        { w: '100%', bg: '#2563eb', label: 'Very strong'},
    ];
    const lvl          = levels[Math.min(score - 1, 4)] || levels[0];
    fill.style.width      = lvl.w;
    fill.style.background = lvl.bg;
    text.textContent      = lvl.label;
    text.style.color      = lvl.bg;
}

// ── Password match ────────────────────────────────
function checkMatch() {
    const newPwd  = document.getElementById('new-pwd').value;
    const confirm = document.getElementById('confirm-pwd').value;
    const hint    = document.getElementById('match-hint');
    if (!confirm) { hint.innerHTML = ''; return; }
    if (newPwd === confirm) {
        hint.innerHTML = '<i class="bi bi-check-circle-fill pwd-match-icon pwd-match-success"></i> <span class="pwd-match-success">Passwords match</span>';
    } else {
        hint.innerHTML = '<i class="bi bi-x-circle-fill pwd-match-icon pwd-match-error"></i> <span class="pwd-match-error">Passwords do not match</span>';
    }
}

function resetPasswordForm() {
    document.getElementById('strength-fill').style.width = '0%';
    document.getElementById('strength-text').textContent = '';
    document.getElementById('match-hint').innerHTML = '';
    document.getElementById('new-pwd').value = '';
    document.getElementById('confirm-pwd').value = '';
    document.getElementById('current-pwd').value = '';
}
</script>

