    font-weight: 500;
    text-transform: capitalize;
}

.fee-history-note {
    color: #64748b;
}

.fee-history-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 18px;
    border-top: 2px solid #e2e8f0;
    background: #f8fafc;
    font-size: 0.82rem;
    font-weight: 600;
}

.fee-history-total {
    font-size: 1rem;
    font-weight: 700;
    color: #059669;
}

/* Empty State */
.fee-history-empty {
    text-align: center;
    padding: 50px 20px;
}

.fee-history-empty__icon {
    width: 60px;
    height: 60px;
    background: #f1f5f9;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
}

.fee-history-empty__icon i {
    font-size: 1.5rem;
    color: #94a3b8;
}

.fee-history-empty p {
    font-size: 0.82rem;
    color: #64748b;
    margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
    .fee-detail-header {
        flex-direction: column;
        align-items: flex-start;
        padding: 14px 18px;
    }
    
    .fee-detail-header__icon {
        width: 38px;
        height: 38px;
        font-size: 1.1rem;
    }
    
    .fee-detail-header__title {
        font-size: 1.1rem;
    }
    
    .fee-detail-back-btn {
        width: 100%;
        justify-content: center;
    }
    
    .fee-summary-card__body,
    .fee-payment-card__body {
        padding: 14px;
    }
    
    .fee-history-table {
        min-width: 500px;
    }
}
</style>


                    <!-- Cancel Fee -->
                    <% if (fee.status !== 'paid' && fee.status !== 'cancelled') { %>
                    <div class="mt-3 pt-3 border-top">
                        <form method="POST" action="/academy/fees/<%= fee.id %>/cancel"
                              onsubmit="return confirm('Cancel this fee? This cannot be undone.')">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                <i class="bi bi-x-circle"></i> Cancel This Fee
                            </button>
                        </form>
                    </div>
                    <% } %>

<%- include('../../partials/footer') %>