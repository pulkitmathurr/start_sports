<%- include('./partials/header') %>

<div class="page-wrapper">

    <!-- ── Page Header ── -->
    <div class="dash-page-header d-flex justify-content-between align-items-end flex-wrap gap-3">
        <div>
            <!-- <div class="header-badge"><span class="pulse-dot"></span>Live Dashboard</div> -->
            <h4>Welcome back, <%= data.user ? data.user.name : user.name %>!</h4>
            <span class="welcome-sub">Here's what's happening with your sports facility today.</span>
        </div>
        <div class="date-chip">
            <i class="bi bi-calendar3 me-1"></i>
            <%= new Date().toLocaleDateString('en-IN', { weekday:'long', year:'numeric', month:'long', day:'numeric' }) %>
        </div>
    </div>

    <!-- ── Announcements from Super Admin ── -->
    <% if (data.announcements && data.announcements.length > 0) { %>
    <div id="announcements-container" style="display:flex; flex-direction:column; gap:10px; margin-bottom:8px;">
        <% data.announcements.forEach(function(ann) { %>
        <%
            const typeMap = {
                info:    { bg: '#e8f4fd', border: '#3498db', color: '#1a6fa0', icon: 'bi-info-circle-fill' },
                success: { bg: '#eafaf1', border: '#27ae60', color: '#1a7a43', icon: 'bi-check-circle-fill' },
                warning: { bg: '#fef9e7', border: '#f39c12', color: '#b7770d', icon: 'bi-exclamation-triangle-fill' },
                danger:  { bg: '#fdecea', border: '#e74c3c', color: '#c0392b', icon: 'bi-x-octagon-fill'  }
            };
            const t = typeMap[ann.type] || typeMap.info;
        %>
        <div class="sa-announcement-banner" id="ann-<%= ann.id %>"
             style="display:flex; align-items:flex-start; gap:12px; padding:14px 18px;
                    background:<%= t.bg %>; border-left:4px solid <%= t.border %>;
                    border-radius:8px; position:relative;">
            <i class="bi <%= t.icon %>" style="color:<%= t.border %>; font-size:18px; margin-top:1px; flex-shrink:0;"></i>
            <div style="flex:1; min-width:0;">
                <div style="font-weight:600; color:<%= t.color %>; font-size:14px; margin-bottom:2px;">
                    <%= ann.title %>
                </div>
                <div style="color:<%= t.color %>; font-size:13px; opacity:0.9; line-height:1.5;">
                    <%= ann.message %>
                </div>
            </div>
            <button onclick="dismissAnnouncement(<%= ann.id %>)"
                    style="background:none; border:none; cursor:pointer; color:<%= t.color %>;
                           opacity:0.6; font-size:18px; line-height:1; padding:0; flex-shrink:0;"
                    title="Dismiss">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <% }); %>
    </div>
    <% } %>

    <script>
    function dismissAnnouncement(id) {
        const el = document.getElementById('ann-' + id);
        if (el) {
            el.style.transition = 'opacity 0.3s';
            el.style.opacity = '0';
            setTimeout(() => {
                el.remove();
                // Hide container if no banners left
                const container = document.getElementById('announcements-container');
                if (container && container.querySelectorAll('.sa-announcement-banner').length === 0) {
                    container.style.display = 'none';
                }
            }, 300);
        }
    }
    </script>

    <!-- ── 8 Stat Cards ── -->
    <div class="stat-grid">

        <!-- 1. Today's Bookings -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Today's Bookings</div>
                <div class="stat-icon si-green"><i class="bi bi-calendar-check"></i></div>
            </div>
            <div class="stat-card__value"><%= data.stats.total_bookings || 0 %></div>
            <div class="stat-card__sub green"><i class="bi bi-check2-circle me-1"></i><%= data.stats.confirmed || 0 %> confirmed</div>
        </div>

        <!-- 2. Today's Revenue -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Today's Revenue</div>
                <div class="stat-icon si-teal"><i class="bi bi-currency-rupee"></i></div>
            </div>
            <div class="stat-card__value sm">₹<%= Number(data.stats.revenue || 0).toLocaleString('en-IN') %></div>
            <div class="stat-card__sub amber"><i class="bi bi-clock me-1"></i>₹<%= Number(data.stats.balance_due || 0).toLocaleString('en-IN') %> due</div>
        </div>

        <!-- 3. Today's Expenses -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Today's Expenses</div>
                <div class="stat-icon si-red"><i class="bi bi-receipt"></i></div>
            </div>
            <div class="stat-card__value sm">₹<%= Number(data.stats.today_expenses || 0).toLocaleString('en-IN') %></div>
            <div class="stat-card__sub red"><i class="bi bi-list-ul me-1"></i><%= data.stats.today_expense_count || 0 %> entries today</div>
        </div>

        <!-- 4. Pending Approvals -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Pending Approvals</div>
                <div class="stat-icon si-amber"><i class="bi bi-hourglass-split"></i></div>
            </div>
            <div class="stat-card__value"><%= data.pendingApprovals ? data.pendingApprovals.length : 0 %></div>
            <div class="stat-card__sub amber"><i class="bi bi-exclamation-circle me-1"></i><%= data.stats.pending || 0 %> pending today</div>
        </div>

        <!-- 5. Monthly Revenue -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Monthly Revenue</div>
                <div class="stat-icon si-green"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
            <div class="stat-card__value sm">₹<%= Number(data.financial.monthly_revenue || 0).toLocaleString('en-IN') %></div>
            <div class="stat-card__sub green"><i class="bi bi-calendar3 me-1"></i><%= data.stats.monthly_confirmed || 0 %> confirmed this month</div>
        </div>

        <!-- 6. Monthly Expenses -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Monthly Expenses</div>
                <div class="stat-icon si-orange"><i class="bi bi-wallet2"></i></div>
            </div>
            <div class="stat-card__value sm">₹<%= Number(data.financial.monthly_expenses || 0).toLocaleString('en-IN') %></div>
            <div class="stat-card__sub red"><i class="bi bi-arrow-down-circle me-1"></i><%= data.financial.expense_count || 0 %> entries</div>
        </div>

        <!-- 7. Net Profit -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Net Profit</div>
                <div class="stat-icon si-purple"><i class="bi bi-bar-chart-line"></i></div>
            </div>
            <div class="stat-card__value sm <%= data.financial.net_profit >= 0 ? '' : 'text-danger' %>">
                ₹<%= Number(data.financial.net_profit || 0).toLocaleString('en-IN') %>
            </div>
            <div class="stat-card__sub <%= data.financial.net_profit >= 0 ? 'green' : 'red' %>">
                <i class="bi bi-percent me-1"></i><%= data.financial.profit_margin || 0 %>% margin
            </div>
        </div>

        <!-- 8. Walk-in vs Online -->
        <div class="stat-card">
            <div class="stat-card__top">
                <div class="stat-card__label">Active Grounds</div>
                <div class="stat-icon si-indigo"><i class="bi bi-geo-alt"></i></div>
            </div>
            <div class="stat-card__value"><%= data.stats.active_grounds || 0 %></div>
            <div class="stat-card__sub blue">
                <i class="bi bi-person-walking me-1"></i><%= data.stats.walkin_count || 0 %> walk-in &nbsp;·&nbsp;
                <i class="bi bi-globe me-1"></i><%= data.stats.online_count || 0 %> online
            </div>
        </div>

    </div>

    <!-- ── Row 2: Financial Summary + Calendar + Chart (3 in one row) ── -->
<div class="row g-3 mb-4">
    <!-- Monthly Summary - Card 1 -->
    <div class="col-xl-3 col-lg-4 col-md-12">
        <div class="dash-card h-100" id="card-monthly-summary" style="display:flex; flex-direction:column;">
            <div class="dash-card-header" style="flex-shrink:0;">
                <h6><i class="bi bi-bar-chart-line"></i>Monthly Summary</h6>
            </div>
            <div class="fin-row" style="flex:1; padding:1rem 1.6rem;">
                <span class="fin-label"><span class="fin-dot" style="background:#2563eb"></span>Revenue</span>
                <span class="fin-value pos">₹<%= Number(data.financial.monthly_revenue || 0).toLocaleString('en-IN') %></span>
            </div>
            <div class="fin-row" style="flex:1; padding:1rem 1.6rem;">
                <span class="fin-label"><span class="fin-dot" style="background:#dc2626"></span>Expenses</span>
                <span class="fin-value neg">₹<%= Number(data.financial.monthly_expenses || 0).toLocaleString('en-IN') %></span>
            </div>
            <hr class="fin-divider" style="margin:0 1.6rem;">
            <div class="fin-row" style="flex:1; padding:1rem 1.6rem;">
                <span class="fin-label"><span class="fin-dot" style="background:#1e293b"></span>Net Profit</span>
                <span class="fin-value <%= data.financial.net_profit >= 0 ? 'pos' : 'neg' %>">₹<%= Number(data.financial.net_profit || 0).toLocaleString('en-IN') %></span>
            </div>
            <div class="fin-row" style="flex:1; padding:1rem 1.6rem;">
                <span class="fin-label"><span class="fin-dot" style="background:#8b5cf6"></span>Profit Margin</span>
                <span class="fin-value"><%= data.financial.profit_margin || 0 %>%</span>
            </div>
        </div>
    </div>

    <!-- Booking Heatmap Calendar - Card 2 -->
    <div class="col-xl-3 col-lg-4 col-md-12">
        <div class="dash-card h-100">
            <div class="dash-card-header" style="padding:.85rem 1rem;">
                <h6 style="font-size:.72rem;"><i class="bi bi-calendar3"></i><span id="calMonthLabel"></span></h6>
                <div class="d-flex align-items-center gap-1">
                    <button class="cal-nav-btn" id="calPrev" onclick="changeCalMonth(-1)"><i class="bi bi-chevron-left"></i></button>
                    <button class="cal-nav-btn" id="calNext" onclick="changeCalMonth(1)"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
            <div class="cal-wrap" style="padding:.85rem 1rem;">
                <div class="cal-grid" id="calGrid" style="gap:3px;"></div>
                <div class="cal-legend" style="margin-top:.6rem; gap:4px;">
                    <span class="cal-legend-label">Less</span>
                    <div class="cal-legend-box" style="background:#f3f4f6;width:10px;height:10px;"></div>
                    <div class="cal-legend-box" style="background:#d1fae5;width:10px;height:10px;"></div>
                    <div class="cal-legend-box" style="background:#6ee7b7;width:10px;height:10px;"></div>
                    <div class="cal-legend-box" style="background:#10b981;width:10px;height:10px;"></div>
                    <div class="cal-legend-box" style="background:#059669;width:10px;height:10px;"></div>
                    <div class="cal-legend-box" style="background:#065f46;width:10px;height:10px;"></div>
                    <span class="cal-legend-label">More</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 7 Day Trend Chart - Card 3 -->
    <div class="col-xl-6 col-lg-4 col-md-12">
        <div class="dash-card h-100" id="card-trend" style="display:flex; flex-direction:column;">
            <div class="dash-card-header" style="flex-shrink:0;">
                <h6><i class="bi bi-graph-up"></i>Last 7 Days Trend</h6>
            </div>
            <div class="chart-wrap" style="flex:1; display:flex; align-items:stretch; padding:1.25rem 1.4rem; min-height:220px;">
                <canvas id="weeklyChart" style="width:100% !important; height:100% !important;"></canvas>
            </div>
        </div>
    </div>
</div>

    <!-- ── Row 4: Pending Approvals + Today's Schedule ── -->
    <div class="row g-3 mb-4">
        <div class="col-xl-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6><i class="bi bi-clock-history"></i>Pending Approvals</h6>
                    <span class="hdr-badge yellow"><%= data.pendingApprovals ? data.pendingApprovals.length : 0 %> waiting</span>
                </div>
                <% if (!data.pendingApprovals || data.pendingApprovals.length === 0) { %>
                    <div class="dash-empty">
                        <div class="empty-icon"><i class="bi bi-check2-all"></i></div>
                        <p>All clear — no pending approvals</p>
                    </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead><tr><th>Booking</th><th>Customer</th><th>Ground</th><th>Amount</th><th>Action</th></tr></thead>
                        <tbody>
                            <% data.pendingApprovals.forEach(function(b) { %>
                            <tr>
                                <td><div class="cell-main"><%= b.booking_no %></div><div class="cell-sub"><%= b.slot_date %></div></td>
                                <td><div class="cell-main"><%= b.customer_name %></div><div class="cell-sub"><%= b.customer_phone %></div></td>
                                <td><div class="cell-main"><%= b.ground_name %></div><div class="cell-sub"><%= b.start_time %> – <%= b.end_time %></div></td>
                                <td><span style="font-weight:700;color:var(--text-h)">₹<%= Number(b.total_amount).toLocaleString('en-IN') %></span></td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <button class="dash-btn approve" onclick="approveBooking(<%= b.id %>)" title="Approve"><i class="bi bi-check-lg"></i></button>
                                        <button class="dash-btn reject"  onclick="rejectBooking(<%= b.id %>)"  title="Reject"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6><i class="bi bi-calendar-day"></i>Today's Schedule</h6>
                    <span class="hdr-badge blue"><%= data.todaySchedule ? data.todaySchedule.length : 0 %> bookings</span>
                </div>
                <% if (!data.todaySchedule || data.todaySchedule.length === 0) { %>
                    <div class="dash-empty">
                        <div class="empty-icon"><i class="bi bi-calendar3"></i></div>
                        <p>No confirmed bookings today</p>
                    </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="dash-table">
                        <thead><tr><th>Time</th><th>Customer</th><th>Ground</th><th>Type</th></tr></thead>
                        <tbody>
                            <% data.todaySchedule.forEach(function(b) { %>
                            <tr>
                                <td><span style="font-size:.78rem;font-weight:700;color:var(--emerald)"><%= b.start_time %> – <%= b.end_time %></span></td>
                                <td><div class="cell-main"><%= b.customer_name %></div><div class="cell-sub"><%= b.customer_phone %></div></td>
                                <td class="cell-main"><%= b.ground_name %></td>
                                <td><span class="dash-badge <%= b.booking_type === 'online' ? 'online' : 'walkin' %>"><%= b.booking_type %></span></td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- ── Row 5: Ground Health + Recent Activity ── -->
    <div class="row g-3 mb-4">
        <div class="col-xl-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6><i class="bi bi-geo-alt"></i>Ground Health</h6>
                    <span class="hdr-badge green"><%= data.grounds ? data.grounds.length : 0 %> grounds</span>
                </div>
                <% if (!data.grounds || data.grounds.length === 0) { %>
                    <div class="dash-empty"><div class="empty-icon"><i class="bi bi-geo"></i></div><p>No grounds configured yet</p></div>
                <% } else { %>
                    <% data.grounds.forEach(function(g) { %>
                    <div class="ground-item">
                        <div class="flex-grow-1">
                            <div class="gi-name">
                                <span class="ground-status-dot <%= g.status === 'active' ? 'active' : 'inactive' %>"></span>
                                <%= g.name %>
                            </div>
                            <div class="gi-sport"><%= g.sport_type %></div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span style="font-size:.75rem;font-weight:700;color:var(--text-h)"><%= g.today_confirmed %>/<%= g.today_total %></span>
                            <div class="dash-progress">
                                <div class="dash-progress-bar" style="width:<%= g.today_total > 0 ? Math.round((g.today_confirmed/g.today_total)*100) : 0 %>%"></div>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="dash-card h-100">
                <div class="dash-card-header">
                    <h6><i class="bi bi-activity"></i>Recent Activity</h6>
                </div>
                <% if (!data.recentActivity || data.recentActivity.length === 0) { %>
                    <div class="dash-empty"><div class="empty-icon"><i class="bi bi-lightning"></i></div><p>No recent activity</p></div>
                <% } else { %>
                    <% data.recentActivity.slice(0, 5).forEach(function(b) { %>
                    <div class="activity-item">
                        <div class="activity-dot"><%= b.customer_name ? b.customer_name.charAt(0).toUpperCase() : '?' %></div>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="act-name text-truncate"><%= b.customer_name %> — <%= b.ground_name %></div>
                            <div class="act-meta"><%= b.booking_no %></div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-1">
                            <span class="act-amount">₹<%= Number(b.total_amount).toLocaleString('en-IN') %></span>
                            <span class="dash-badge
                                <% if(b.booking_status==='confirmed'){%>confirmed<%}else if(b.booking_status==='pending'){%>pending<%}else if(b.booking_status==='cancelled'){%>cancelled<%}else{%>walkin<%}%>">
                                <%= b.booking_status %>
                            </span>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>

</div>

<!-- Scripts -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
/* ── Weekly Chart ── */
const trendRaw = <%- JSON.stringify(data.weeklyTrend) %>;
const labels = [], bookingsData = [], revenueData = [];
for (let i = 6; i >= 0; i--) {
    const d = new Date(); d.setDate(d.getDate() - i);
    const dateStr = d.toISOString().split('T')[0];
    const found = trendRaw.find(r => r.date === dateStr);
    labels.push(d.toLocaleDateString('en-IN', { weekday:'short', day:'numeric' }));
    bookingsData.push(found ? Number(found.bookings) : 0);
    revenueData.push(found ? Number(found.revenue) : 0);
}
const ctx = document.getElementById('weeklyChart').getContext('2d');
const greenGrad = ctx.createLinearGradient(0,0,0,200);
greenGrad.addColorStop(0,'rgba(5,150,105,.18)');
greenGrad.addColorStop(1,'rgba(5,150,105,0)');
new Chart(ctx, {
    type:'bar',
    data: {
        labels,
        datasets: [
            { label:'Bookings', data:bookingsData, backgroundColor:'rgba(5,150,105,.75)', borderRadius:6, borderSkipped:false, yAxisID:'y' },
            { label:'Revenue (₹)', data:revenueData, type:'line', borderColor:'#059669', backgroundColor:greenGrad, fill:true, tension:.45, pointBackgroundColor:'#fff', pointBorderColor:'#059669', pointBorderWidth:2.5, pointRadius:4, pointHoverRadius:6, yAxisID:'y1' }
        ]
    },
    options: {
        responsive:true, maintainAspectRatio:false, interaction:{mode:'index',intersect:false},
        animation:{duration:900,easing:'easeOutQuart'},
        plugins: {
            legend: { position:'top', labels:{ font:{family:"'Plus Jakarta Sans'",size:11,weight:'600'}, usePointStyle:true, pointStyleWidth:8, color:'#374151' } },
            tooltip: { backgroundColor:'#0f2d1e', titleFont:{family:"'Plus Jakarta Sans'",size:12}, bodyFont:{family:"'Plus Jakarta Sans'",size:11}, cornerRadius:10, padding:12 }
        },
        scales: {
            x: { grid:{display:false}, ticks:{font:{family:"'Plus Jakarta Sans'",size:10,weight:'600'},color:'#9ca3af'} },
            y: { beginAtZero:true, position:'left', grid:{color:'rgba(0,0,0,.04)'}, ticks:{font:{family:"'Plus Jakarta Sans'",size:10},color:'#9ca3af',stepSize:1} },
            y1:{ beginAtZero:true, position:'right', grid:{drawOnChartArea:false}, ticks:{font:{family:"'Plus Jakarta Sans'",size:10},color:'#9ca3af'} }
        }
    }
});

/* ── Booking Heatmap Calendar ── */
// monthlyBookings is now [{date:'2025-04-01', count:3}, ...]
const monthlyBookings = <%- JSON.stringify(data.monthlyBookings) %>;

// Build a map: date string → count directly from pre-aggregated data
const currentMonthMap = {};
monthlyBookings.forEach(r => { currentMonthMap[r.date] = Number(r.count); });

let calYear  = new Date().getFullYear();
let calMonth = new Date().getMonth(); // 0-indexed
const todayStr = new Date().toISOString().split('T')[0];

function getHeatLevel(count, max) {
    if (!count || count === 0) return 'no-booking';
    const pct = count / max;
    if (pct <= .2)  return 'level-1';
    if (pct <= .4)  return 'level-2';
    if (pct <= .6)  return 'level-3';
    if (pct <= .8)  return 'level-4';
    return 'level-5';
}

function renderCalendar(year, month, bookingMap) {
    bookingMap = bookingMap || {};
    const monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];
    document.getElementById('calMonthLabel').textContent = monthNames[month] + ' ' + year;

    const grid = document.getElementById('calGrid');
    grid.innerHTML = '';

    // Day labels
    ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].forEach(d => {
        const lbl = document.createElement('div');
        lbl.className = 'cal-day-label';
        lbl.textContent = d;
        grid.appendChild(lbl);
    });

    const firstDay = new Date(year, month, 1).getDay();
    const daysInMonth = new Date(year, month + 1, 0).getDate();

    
    // Max count for heat scaling
    const max = Math.max(1, ...Object.values(bookingMap));

    // Empty cells before 1st
    for (let i = 0; i < firstDay; i++) {
        const empty = document.createElement('div');
        empty.className = 'cal-day empty';
        grid.appendChild(empty);
    }

    for (let day = 1; day <= daysInMonth; day++) {
        const dateStr = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
        const count   = bookingMap[dateStr] || 0;
        const level   = getHeatLevel(count, max);

        const cell = document.createElement('div');
        cell.className = `cal-day ${level}${dateStr === todayStr ? ' today-cell' : ''}`;
        cell.style.cursor = count > 0 ? 'pointer' : 'default';
        cell.title = count > 0 ? `${count} booking${count !== 1 ? 's' : ''} — click to view` : '';

        if (count > 0) {
            cell.addEventListener('click', () => {
                window.location.href = `/bookings?date=${dateStr}`;
            });
        }

        const numEl = document.createElement('div');
        numEl.className = 'day-num';
        numEl.textContent = day;
        cell.appendChild(numEl);

        if (count > 0) {
            const cntEl = document.createElement('div');
            cntEl.className = 'day-count';
            cntEl.textContent = count + 'b';
            cell.appendChild(cntEl);
            cell.setAttribute('data-tip', `${count} booking${count !== 1 ? 's' : ''}`);
        }

        grid.appendChild(cell);
    }

    
}

const monthCache = {};  // add this line at the top near other let/const declarations

function changeCalMonth(dir) {
    calMonth += dir;
    if (calMonth < 0)  { calMonth = 11; calYear--; }
    if (calMonth > 11) { calMonth = 0;  calYear++; }

    const key = `${calYear}-${calMonth}`;
    const nowM = new Date();
    const isCurrentMonth = (calYear === nowM.getFullYear() && calMonth === nowM.getMonth());

    if (isCurrentMonth) {
        renderCalendar(calYear, calMonth, currentMonthMap);
    } else if (monthCache[key]) {
        renderCalendar(calYear, calMonth, monthCache[key]);
    } else {
        renderCalendar(calYear, calMonth, {});  // show empty while loading
        fetch(`/dashboard/month-bookings?year=${calYear}&month=${calMonth + 1}`)
    .then(r => r.json())
    .then(data => {
        const map = {};
        (data.bookings || []).forEach(r => { map[r.date] = Number(r.count); });
                monthCache[key] = map;
                renderCalendar(calYear, calMonth, map);
            })
            .catch(() => {});
    }
}

// Init calendar
renderCalendar(calYear, calMonth, currentMonthMap);

/* ── Booking Actions ── */
async function approveBooking(id) {
    showDelModal({
        title: 'Approve Booking',
        message: 'Approve this booking? The customer will be notified.',
        confirmText: 'Yes, Approve', cancelText: 'Cancel',
        icon: 'bi bi-check-circle-fill', iconClass: 'del-modal__icon--success', confirmClass: 'success'
    }, async () => {
        const csrf = document.cookie.match(/csrf_token=([^;]+)/)?.[1] || '';
        const res  = await fetch('/dashboard/approve', { method:'POST', headers:{'Content-Type':'application/json','X-CSRF-Token':csrf}, body:JSON.stringify({booking_id:id}) });
        const data = await res.json();
        if (data.success) location.reload(); else xToast('Failed to approve booking.', 'error');
    });
}
async function rejectBooking(id) {
    showInputModal({
        title: 'Reject Booking',
        message: 'Please provide a reason for rejection. The customer will be notified.',
        placeholder: 'e.g. Ground not available, Payment not received...',
        confirmText: 'Reject Booking',
        icon: 'bi bi-x-circle-fill', iconClass: 'del-modal__icon--danger',
        rows: 2
    }, async (reason) => {
        const csrf = document.cookie.match(/csrf_token=([^;]+)/)?.[1] || '';
        const res  = await fetch('/dashboard/reject', { method:'POST', headers:{'Content-Type':'application/json','X-CSRF-Token':csrf}, body:JSON.stringify({booking_id:id, reason}) });
        const data = await res.json();
        if (data.success) location.reload(); else xToast('Failed to reject booking.', 'error');
    });
}

// ── Stat Card Count-up Animation ──
document.addEventListener('DOMContentLoaded', () => {
    const statEls = document.querySelectorAll('.stat-card__value, .bk-stat-card__value');
    statEls.forEach(el => {
        const raw = el.innerText.replace(/[₹,\s]/g, '');
        const target = parseFloat(raw);
        if (isNaN(target) || target === 0) return;
        const isRupee = el.innerText.includes('₹');
        const duration = 1000;
        const steps = 40;
        const interval = duration / steps;
        let current = 0;
        el.innerText = isRupee ? '₹0' : '0';
        const timer = setInterval(() => {
            current += target / steps;
            if (current >= target) {
                current = target;
                clearInterval(timer);
            }
            const formatted = Math.floor(current).toLocaleString('en-IN');
            el.innerText = isRupee ? '₹' + formatted : formatted;
        }, interval);
    });
});
</script>

