<%- include('../partials/header') %>

<div class="cp-page">

    <!-- Hero Header -->
    <div class="cp-hero">
        <div class="cp-hero__left">
            <a href="/customers" class="cp-back-btn"><i class="bi bi-arrow-left"></i></a>
            <div class="cp-hero-avatar"><%= customer.name.charAt(0).toUpperCase() %></div>
            <div>
                <div class="cp-hero__eyebrow">Customer Profile</div>
                
                <div class="cp-hero__meta">
                    <span class="cp-hero__cid"><%= customer.customer_id %></span>
                    <span class="cp-hero__since">
                        <i class="bi bi-calendar3"></i>
                        Member since <%= new Date(customer.created_at).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>
                    </span>
                </div>
            </div>
        </div>
        <div class="cp-hero__right">
            <div class="cp-hero__spent">
                <span class="cp-hero__spent-label">Total Spent</span>
                <span class="cp-hero__spent-val">₹<%= Number(stats.total_spent || 0).toLocaleString('en-IN') %></span>
            </div>
            
        </div>
    </div>

    <!-- Info + Stats -->
    <div class="cp-layout">

        <!-- Left: Customer Info -->
        <div>
            <div class="cp-info-card">
                <div class="cp-info-card__header">
                    <div class="cp-info-card__header-icon"><i class="bi bi-person"></i></div>
                    <span class="cp-info-card__title">Customer Info</span>
                </div>
                <div class="cp-info-card__body">

                    <div class="cp-info-row">
                        <div class="cp-info-row__icon"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <div class="cp-info-row__label">Phone</div>
                            <div class="cp-info-row__value"><%= customer.phone %></div>
                        </div>
                    </div>

                    <div class="cp-info-row">
                        <div class="cp-info-row__icon"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <div class="cp-info-row__label">Email</div>
                            <div class="cp-info-row__value <%= !customer.email ? 'cp-info-row__value--muted' : '' %>">
                                <%= customer.email || 'No email added' %>
                            </div>
                        </div>
                    </div>

                    <div class="cp-info-row">
                        <div class="cp-info-row__icon"><i class="bi bi-geo-alt-fill"></i></div>
                        <div style="flex:1; min-width:0;">
                            <div class="cp-info-row__label">Address</div>
                            <div class="cp-info-row__value <%= !customer.address ? 'cp-info-row__value--muted' : '' %>" id="address-display">
                                <%= customer.address || 'No address added' %>
                            </div>
                            <div class="cp-address-edit" id="address-edit">
                                <input type="text" id="address-input" class="cp-address-input"
                                    placeholder="Enter address..."
                                    value="<%= customer.address || '' %>">
                                <div class="cp-address-actions">
                                    <button class="cp-btn-save" onclick="saveAddress()">
                                        <i class="bi bi-check2"></i> Save
                                    </button>
                                    <button class="cp-btn-cancel-addr" onclick="toggleAddressEdit()">Cancel</button>
                                </div>
                            </div>
                            <button class="cp-btn-edit-addr" onclick="toggleAddressEdit()" id="edit-addr-btn">
                                <i class="bi bi-pencil"></i> Edit Address
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <!-- Right: Stats + Insights -->
        <div class="d-flex flex-column gap-3">

            <div class="cp-stats">
                <div class="cp-stat-card cp-stat-card--total">
                    <div class="cp-stat-card__hd">
                        <span class="cp-stat-card__label">Total Bookings</span>
                        <div class="cp-stat-card__icon"><i class="bi bi-calendar3"></i></div>
                    </div>
                    <div class="cp-stat-card__value"><%= stats.total_bookings || 0 %></div>
                </div>
                <div class="cp-stat-card cp-stat-card--confirmed">
                    <div class="cp-stat-card__hd">
                        <span class="cp-stat-card__label">Confirmed</span>
                        <div class="cp-stat-card__icon"><i class="bi bi-check-circle-fill"></i></div>
                    </div>
                    <div class="cp-stat-card__value"><%= stats.confirmed || 0 %></div>
                </div>
                <div class="cp-stat-card cp-stat-card--cancelled">
                    <div class="cp-stat-card__hd">
                        <span class="cp-stat-card__label">Cancelled</span>
                        <div class="cp-stat-card__icon"><i class="bi bi-x-circle-fill"></i></div>
                    </div>
                    <div class="cp-stat-card__value"><%= stats.cancelled || 0 %></div>
                </div>
                <div class="cp-stat-card cp-stat-card--revenue">
                    <div class="cp-stat-card__hd">
                        <span class="cp-stat-card__label">Total Spent</span>
                        <div class="cp-stat-card__icon"><i class="bi bi-currency-rupee"></i></div>
                    </div>
                    <div class="cp-stat-card__value cp-stat-card__value--sm">₹<%= Number(stats.total_spent || 0).toLocaleString('en-IN') %></div>
                </div>
            </div>

            <div class="cp-insights">
                <div class="cp-insight-card">
                    <div class="cp-insight-card__icon"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <div class="cp-insight-card__label">Favourite Ground</div>
                        <div class="cp-insight-card__value"><%= stats.favourite_ground || '—' %></div>
                    </div>
                </div>
                <div class="cp-insight-card">
                    <div class="cp-insight-card__icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <div class="cp-insight-card__label">Preferred Slot</div>
                        <div class="cp-insight-card__value"><%= stats.preferred_slot || '—' %></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Filters -->
    <div class="cp-filter-panel">
        <form method="GET" action="/customers/<%= customer.customer_id %>">
            <div class="cp-filter-row">
                <div class="cp-filter-field cp-filter-field--search">
                    <label class="cp-filter-label">Search</label>
                    <input type="text" name="search" class="cp-filter-input"
                        placeholder="Booking ID or ground..." value="<%= filters.search || '' %>">
                </div>
                <div class="cp-filter-field">
                    <label class="cp-filter-label">Status</label>
                    <select name="status" class="cp-filter-select">
                        <option value="">All Status</option>
                        <option value="confirmed" <%= filters.status==='confirmed' ? 'selected' : '' %>>Confirmed</option>
                        <option value="pending"   <%= filters.status==='pending'   ? 'selected' : '' %>>Pending</option>
                        <option value="cancelled" <%= filters.status==='cancelled' ? 'selected' : '' %>>Cancelled</option>
                        <option value="rejected"  <%= filters.status==='rejected'  ? 'selected' : '' %>>Rejected</option>
                        <option value="expired"   <%= filters.status==='expired'   ? 'selected' : '' %>>Expired</option>
                    </select>
                </div>
                <div class="cp-filter-field">
                    <label class="cp-filter-label">From</label>
                    <input type="date" name="date_from" class="cp-filter-input" value="<%= filters.date_from || '' %>">
                </div>
                <div class="cp-filter-field">
                    <label class="cp-filter-label">To</label>
                    <input type="date" name="date_to" class="cp-filter-input" value="<%= filters.date_to || '' %>">
                </div>
                <div class="cp-filter-actions">
                    <button type="submit" class="cp-btn-filter">
                        <i class="bi bi-funnel"></i> Filter
                    </button>
                    <a href="/customers/<%= customer.customer_id %>" class="cp-btn-reset">
                        <i class="bi bi-x-lg"></i> Reset
                    </a>
                </div>
            </div>
        </form>
    </div>

    <!-- Bookings Table -->
    <% if (bookings.length === 0) { %>
    <div class="cp-empty">
        <div class="cp-empty__icon"><i class="bi bi-calendar-x"></i></div>
        <p class="cp-empty__title">No bookings found</p>
        <small class="cp-empty__sub">No bookings match the current filters</small>
    </div>
    <% } else { %>
    <div class="cp-table-card">
        <div class="cp-table-card__hd">
            <span class="cp-table-card__title">
                <i class="bi bi-table"></i> Booking History
            </span>
            <span class="cp-table-card__meta"><%= pagination.totalRecords %> booking<%= pagination.totalRecords !== 1 ? 's' : '' %></span>
        </div>

        <div class="table-responsive">
            <table class="cp-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Booking ID</th>
                        <th>Ground</th>
                        <th>Date</th>
                        <th>Time Slot</th>
                        <th>Base</th>
                        <!-- <th>Discount</th> -->
                        <th>Surcharge</th>
                        <th>Total</th>
                        <th>Paid</th>
                        <th>Balance</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Booked By</th>
                        <th>Details</th>
                    </tr>
                </thead>
                <tbody>
                    <% bookings.forEach((booking, index) => { %>
                    <%
                        const hasDiscount  = booking.discount_amount  && parseFloat(booking.discount_amount)  > 0;
                        const hasSurcharge = booking.surcharge_amount && parseFloat(booking.surcharge_amount) > 0;
                        const hasNotes     = booking.notes || booking.pricing_note;
                        const hasBillingInfo = true; // always show View button
                    %>
                    <tr>
                        <td><span class="cp-row-num"><%= ((pagination.currentPage - 1) * pagination.limit) + index + 1 %></span></td>
                        <td>
                            <span class="cp-booking-no"><%= booking.booking_no %></span>
                            <!-- <% if (booking.booking_type === 'walkin') { %>
                                <span class="cp-type-badge cp-type-badge--walkin">Walk-in</span>
                            <% } else if (booking.booking_type === 'phone') { %>
                                <span class="cp-type-badge cp-type-badge--phone">Phone</span>
                            <% } else { %>
                                <span class="cp-type-badge cp-type-badge--online">Online</span>
                            <% } %> -->
                        </td>
                        <td><span class="cp-ground-name"><%= booking.ground_name || '—' %></span></td>
                        <td><span class="cp-slot-date"><%= new Date(booking.slot_date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %></span></td>
                        <td><span class="cp-slot-time"><%= booking.start_time ? booking.start_time.slice(0,5) : '—' %> – <%= booking.end_time ? booking.end_time.slice(0,5) : '—' %></span></td>
                        <td><span class="cp-amount-base">₹<%= Number(booking.original_amount || booking.total_amount || 0).toLocaleString('en-IN') %></span></td>
                        <td>
                            <% if (hasDiscount) { %>
                                <span class="cp-amount-discount">−₹<%= Number(booking.discount_amount).toLocaleString('en-IN') %></span>
                            <% } else { %><span class="cp-amount-nil">—</span><% } %>
                        </td>
                        <!-- <td>
                            <% if (hasSurcharge) { %>
                                <span class="cp-amount-surcharge">+₹<%= Number(booking.surcharge_amount).toLocaleString('en-IN') %></span>
                            <% } else { %><span class="cp-amount-nil">—</span><% } %>
                        </td> -->
                        <td><span class="cp-amount">₹<%= Number(booking.total_amount || 0).toLocaleString('en-IN') %></span></td>
                        <td><span class="cp-amount-paid">₹<%= Number(booking.advance_amount || 0).toLocaleString('en-IN') %></span></td>
                        <td>
                            <% if (parseFloat(booking.balance_amount || 0) > 0) { %>
                                <span class="cp-amount-balance">₹<%= Number(booking.balance_amount).toLocaleString('en-IN') %></span>
                            <% } else { %><span class="cp-amount-nil">—</span><% } %>
                        </td>
                        <td>
                            <% if (booking.payment_status === 'paid') { %>
                                <span class="cp-badge cp-badge--green">Paid</span>
                            <% } else if (booking.payment_status === 'partial') { %>
                                <span class="cp-badge cp-badge--amber">Partial</span>
                            <% } else { %>
                                <span class="cp-badge cp-badge--grey">Pending</span>
                            <% } %>
                        </td>
                        <td>
                            <% const s = booking.booking_status; %>
                            <% if (s === 'confirmed' || s === 'completed') { %>
                                <span class="cp-badge cp-badge--green"><%= s.charAt(0).toUpperCase() + s.slice(1) %></span>
                            <% } else if (s === 'pending') { %>
                                <span class="cp-badge cp-badge--amber">Pending</span>
                            <% } else if (s === 'approved') { %>
                                <span class="cp-badge cp-badge--blue">Approved</span>
                            <% } else if (s === 'cancelled' || s === 'rejected') { %>
                                <span class="cp-badge cp-badge--red"><%= s.charAt(0).toUpperCase() + s.slice(1) %></span>
                            <% } else { %>
                                <span class="cp-badge cp-badge--grey"><%= s.charAt(0).toUpperCase() + s.slice(1) %></span>
                            <% } %>
                        </td>
                        <td>
                            <div class="cp-booked-by">
                                <span class="cp-booked-by__name"><%= booking.customer_name || '—' %></span>
                                <% if (booking.customer_email) { %>
                                    <span class="cp-booked-by__email"><%= booking.customer_email %></span>
                                <% } %>
                            </div>
                        </td>
                        <td>
                            <% if (hasBillingInfo) { %>
                                <button class="cp-detail-btn" onclick="openBookingModal(this)" 
                                    data-booking-no="<%= booking.booking_no %>"
                                    data-ground="<%= booking.ground_name || '' %>"
                                    data-date="<%= new Date(booking.slot_date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) %>"
                                    data-time="<%= (booking.start_time ? booking.start_time.slice(0,5) : '—') %> – <%= (booking.end_time ? booking.end_time.slice(0,5) : '—') %>"
                                    data-base="<%= Number(booking.original_amount || booking.total_amount || 0).toLocaleString('en-IN') %>"
                                    data-discount="<%= hasDiscount ? Number(booking.discount_amount).toLocaleString('en-IN') : '' %>"
                                    data-surcharge="<%= hasSurcharge ? Number(booking.surcharge_amount).toLocaleString('en-IN') : '' %>"
                                    data-total="<%= Number(booking.total_amount || 0).toLocaleString('en-IN') %>"
                                    data-paid="<%= Number(booking.advance_amount || 0).toLocaleString('en-IN') %>"
                                    data-balance="<%= parseFloat(booking.balance_amount || 0) > 0 ? Number(booking.balance_amount).toLocaleString('en-IN') : '' %>"
                                    data-pricing-note="<%= booking.pricing_note || '' %>"
                                    data-notes="<%= booking.notes || '' %>"
                                    data-booked-name="<%= booking.customer_name || '' %>"
                                    data-booked-email="<%= booking.customer_email || '' %>">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            <% } else { %><span class="cp-amount-nil">—</span><% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <div class="cp-table-card__ft d-flex justify-content-between align-items-center px-3 py-2">
            <span class="cp-table-card__meta">
                Showing <%= ((pagination.currentPage - 1) * pagination.limit) + 1 %>–<%= Math.min(pagination.currentPage * pagination.limit, pagination.totalRecords) %> of <strong><%= pagination.totalRecords %></strong> bookings
            </span>
            <nav>
                <ul class="pagination cp-pagination mb-0">
                    <% if (pagination.currentPage > 1) { %>
                    <li class="page-item">
                        <a class="page-link" href="/customers/<%= customer.customer_id %>?page=<%= pagination.currentPage - 1 %>"><i class="bi bi-chevron-left"></i></a>
                    </li>
                    <% } %>
                    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                    <li class="page-item <%= i === pagination.currentPage ? 'active' : '' %>">
                        <a class="page-link" href="/customers/<%= customer.customer_id %>?page=<%= i %>"><%= i %></a>
                    </li>
                    <% } %>
                    <% if (pagination.currentPage < pagination.totalPages) { %>
                    <li class="page-item">
                        <a class="page-link" href="/customers/<%= customer.customer_id %>?page=<%= pagination.currentPage + 1 %>"><i class="bi bi-chevron-right"></i></a>
                    </li>
                    <% } %>
                </ul>
            </nav>
        </div>
    </div>
    <% } %>

</div>

<script>
const CUSTOMER_ID = '<%= customer.customer_id %>';

function toggleAddressEdit() {
    const editDiv  = document.getElementById('address-edit');
    const editBtn  = document.getElementById('edit-addr-btn');
    const isOpen   = editDiv.classList.contains('open');
    editDiv.classList.toggle('open');
    editBtn.style.display = isOpen ? '' : 'none';
}

async function saveAddress() {
    const address = document.getElementById('address-input').value.trim();
    if (!address) return;
    try {
        const res  = await fetch(`/customers/${CUSTOMER_ID}/address`, {
            method: 'POST',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ address })
        });
        const data = await res.json();
        if (data.success) {
            document.getElementById('address-display').textContent = address;
            document.getElementById('address-display').classList.remove('cp-info-row__value--muted');
            toggleAddressEdit();
        }
    } catch (err) { console.error('Address save failed', err); }
}
function openBookingModal(btn) {
    const d = btn.dataset;
    document.getElementById('bm-booking-no').textContent   = d.bookingNo  || '—';
    document.getElementById('bm-ground').textContent       = d.ground     || '—';
    document.getElementById('bm-date').textContent         = d.date       || '—';
    document.getElementById('bm-time').textContent         = d.time       || '—';
    document.getElementById('bm-base').textContent         = '₹' + (d.base  || '0');
    document.getElementById('bm-total').textContent        = '₹' + (d.total || '0');
    document.getElementById('bm-paid').textContent         = '₹' + (d.paid  || '0');

    // Discount row
    const discRow = document.getElementById('bm-row-discount');
    if (d.discount) {
        document.getElementById('bm-discount').textContent = '−₹' + d.discount;
        discRow.style.display = '';
    } else { discRow.style.display = 'none'; }

    // Surcharge row
    const surRow = document.getElementById('bm-row-surcharge');
    if (d.surcharge) {
        document.getElementById('bm-surcharge').textContent = '+₹' + d.surcharge;
        surRow.style.display = '';
    } else { surRow.style.display = 'none'; }

    // Balance row
    const balRow = document.getElementById('bm-row-balance');
    if (d.balance) {
        document.getElementById('bm-balance').textContent = '₹' + d.balance;
        balRow.style.display = '';
    } else { balRow.style.display = 'none'; }

    // Pricing note
    const pnSec = document.getElementById('bm-section-pricing-note');
    if (d.pricingNote && d.pricingNote.trim()) {
        document.getElementById('bm-pricing-note').textContent = d.pricingNote;
        pnSec.style.display = '';
    } else { pnSec.style.display = 'none'; }

    // Notes
    const nSec = document.getElementById('bm-section-notes');
    if (d.notes && d.notes.trim()) {
        document.getElementById('bm-notes').textContent = d.notes;
        nSec.style.display = '';
    } else { nSec.style.display = 'none'; }

    // Booked By
    const bbSec = document.getElementById('bm-section-booked-by');
    if (d.bookedName && d.bookedName.trim()) {
        document.getElementById('bm-booked-name').textContent  = d.bookedName;
        document.getElementById('bm-booked-email').textContent = d.bookedEmail || '';
        bbSec.style.display = '';
    } else { bbSec.style.display = 'none'; }

    document.getElementById('bookingDetailModal').style.display = 'flex';
}

function closeBookingModal() {
    document.getElementById('bookingDetailModal').style.display = 'none';
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeBookingModal();
});
</script>

<!-- Booking Detail Modal -->
<div id="bookingDetailModal" style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.45); align-items:center; justify-content:center; padding:12px;">
    <div style="background:#fff; border-radius:16px; width:100%; max-width:400px; box-shadow:0 12px 40px rgba(0,0,0,0.2); overflow:hidden;">
        <!-- Modal Header -->
        <div style="background:linear-gradient(135deg,#1e3a5f,#2563eb); padding:14px 18px; display:flex; justify-content:space-between; align-items:center;">
            <div>
                <div style="color:#93c5fd; font-size:0.7rem; font-weight:600; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Booking Details</div>
                <div id="bm-booking-no" style="color:#fff; font-size:1.1rem; font-weight:700;">—</div>
            </div>
            <button onclick="closeBookingModal()" style="background:rgba(255,255,255,0.15); border:none; color:#fff; border-radius:8px; width:32px; height:32px; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center;">&times;</button>
        </div>
        <!-- Modal Body -->
        <div style="padding:14px 18px; display:flex; flex-direction:column; gap:10px;">

            <!-- Booking Info -->
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                <div style="background:#f8faff; border-radius:8px; padding:8px 12px;">
                    <div style="font-size:0.65rem; color:#6b7280; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px;"><i class="bi bi-geo-alt"></i> Ground</div>
                    <div id="bm-ground" style="font-size:0.88rem; font-weight:600; color:#111827;">—</div>
                </div>
                <div style="background:#f8faff; border-radius:8px; padding:8px 12px;">
                    <div style="font-size:0.65rem; color:#6b7280; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px;"><i class="bi bi-calendar3"></i> Date</div>
                    <div id="bm-date" style="font-size:0.88rem; font-weight:600; color:#111827;">—</div>
                </div>
                <div style="background:#f8faff; border-radius:8px; padding:8px 12px; grid-column:1/-1;">
                    <div style="font-size:0.65rem; color:#6b7280; text-transform:uppercase; letter-spacing:0.8px; margin-bottom:4px;"><i class="bi bi-clock"></i> Time Slot</div>
                    <div id="bm-time" style="font-size:0.88rem; font-weight:600; color:#111827;">—</div>
                </div>
            </div>

            <!-- Billing Breakdown -->
            <div style="border:1px solid #e5e7eb; border-radius:12px; overflow:hidden;">
                <div style="background:#f3f4f6; padding:7px 12px; font-size:0.68rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; color:#6b7280;">
                    <i class="bi bi-receipt"></i> Billing Breakdown
                </div>
                <div style="padding:4px 0;">
                    <div style="display:flex; justify-content:space-between; padding:6px 12px; border-bottom:1px solid #f3f4f6;">
                        <span style="font-size:0.82rem; color:#6b7280;">Base Price</span>
                        <span id="bm-base" style="font-size:0.82rem; font-weight:600; color:#374151;">—</span>
                    </div>
                    <div id="bm-row-discount" style="display:flex; justify-content:space-between; padding:6px 12px; border-bottom:1px solid #f3f4f6; background:#f0fdf4;">
                        <span style="font-size:0.82rem; color:#16a34a;"><i class="bi bi-tag"></i> Discount</span>
                        <span id="bm-discount" style="font-size:0.82rem; font-weight:700; color:#16a34a;">—</span>
                    </div>
                    <div id="bm-row-surcharge" style="display:flex; justify-content:space-between; padding:6px 12px; border-bottom:1px solid #f3f4f6; background:#fffbeb;">
