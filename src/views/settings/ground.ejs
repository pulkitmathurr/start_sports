<%- include('../partials/header') %>

<div class="row settings-page-header">

    <!-- Page Header -->
    <div class="col-12 mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h4 class="fw-bold mb-1" style="font-family:'Rajdhani',sans-serif; letter-spacing:1px; color:#1B4332;">
                    Ground Settings
                </h4>
                <small style="color:#ADB5BD;">Manage ground info, timings and pricing</small>
            </div>
            
        </div>
    </div>

    <!-- Success Banner -->
    <% if (success) { %>
    <div class="col-12">
        <div class="settings-success">
            <i class="bi bi-check-circle-fill"></i>
            Settings saved successfully — future slots have been regenerated with new configuration.
        </div>
    </div>
    <% } %>

    <form method="POST" action="/settings/update">

        <!-- ── Section 1: Ground Info ─────────────── -->
        <div class="col-12">
            <div class="settings-card">
                <div class="settings-card-header">
                    <i class="bi bi-building"></i>
                    Ground Information
                </div>
                <div class="settings-card-body">
                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <label class="s-label">Ground Name</label>
                            <input type="text" name="ground_name"
                                value="<%= settings.ground_name || '' %>"
                                placeholder="e.g. Start Sports Arena"
                                class="s-input">
                            <small class="s-hint">Shown to customers on the booking site</small>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="s-label">Contact Number</label>
                            <input type="tel" name="ground_phone"
                                value="<%= settings.ground_phone || '' %>"
                                placeholder="e.g. 9876543210"
                                class="s-input">
                            <small class="s-hint">Customer support number</small>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="s-label">Address</label>
                            <input type="text" name="ground_address"
                                value="<%= settings.ground_address || '' %>"
                                placeholder="e.g. Sector 12, Jaipur"
                                class="s-input">
                            <small class="s-hint">Full ground address</small>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 2: Operating Hours ────────── -->
        <div class="col-12">
            <div class="settings-card">
                <div class="settings-card-header">
                    <i class="bi bi-clock"></i>
                    Operating Hours & Booking Rules
                </div>
                <div class="settings-card-body">
                    <div class="row g-3">

                        <div class="col-6 col-md-3">
                            <label class="s-label">Opens At</label>
                            <input type="time" name="open_time"
                                value="<%= settings.open_time ? settings.open_time.slice(0,5) : '' %>"
                                class="s-input">
                            <small class="s-hint">Ground opens from this time</small>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="s-label">Closes At</label>
                            <input type="time" name="close_time"
                                value="<%= settings.close_time ? settings.close_time.slice(0,5) : '' %>"
                                class="s-input">
                            <small class="s-hint">Ground closes at this time</small>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="s-label">Minimum Slot Duration (minutes)</label>
                            <input type="number" name="min_slot_minutes"
                                value="<%= settings.min_slot_minutes || 30 %>"
                                placeholder="e.g. 30"
                                min="15" max="120"
                                class="s-input">
                            <small class="s-hint">Shortest booking allowed (e.g. 30 min)</small>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="s-label">Advance Booking (days)</label>
                            <input type="number" name="advance_booking_days"
                                value="<%= settings.advance_booking_days || '' %>"
                                placeholder="e.g. 3"
                                min="0" max="30"
                                class="s-input">
                            <small class="s-hint">How many days ahead customers can book</small>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 3: Peak Hours & Pricing ───── -->
        <div class="col-12">
            <div class="settings-card">
                <div class="settings-card-header">
                    <i class="bi bi-graph-up-arrow"></i>
                    Peak Hours & Pricing
                </div>
                <div class="settings-card-body">

                    <p class="s-divider">Peak Hour Window</p>
                    <div class="row g-3 mb-4">

                        <div class="col-6 col-md-3">
                            <label class="s-label">Peak Starts At</label>
                            <input type="time" name="peak_start_time"
                                value="<%= settings.peak_start_time ? settings.peak_start_time.slice(0,5) : '' %>"
                                class="s-input">
                            <small class="s-hint">Peak pricing applies from here</small>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="s-label">Peak Ends At</label>
                            <input type="time" name="peak_end_time"
                                value="<%= settings.peak_end_time ? settings.peak_end_time.slice(0,5) : '' %>"
                                class="s-input">
                            <small class="s-hint">Off-peak pricing resumes after</small>
                        </div>

                    </div>

                    <p class="s-divider">Dynamic Pricing (per 30 minutes)</p>
                    <div class="row g-3">

                        <div class="col-6 col-md-3">
                            <label class="s-label">Normal Rate per 30 min (₹)</label>
                            <input type="number" name="normal_rate_per_30"
                                value="<%= settings.normal_rate_per_30 || 100 %>"
                                placeholder="e.g. 100"
                                min="0" step="0.01"
                                class="s-input">
                            <small class="s-hint">Rate per 30 min during normal hours</small>
                        </div>

                        <div class="col-6 col-md-3">
                            <label class="s-label">Peak Rate per 30 min (₹)</label>
                            <input type="number" name="peak_rate_per_30"
                                value="<%= settings.peak_rate_per_30 || 150 %>"
                                placeholder="e.g. 150"
                                min="0" step="0.01"
                                class="s-input">
                            <small class="s-hint">Rate per 30 min during peak hours</small>
                        </div>

                        <!-- Rate explanation -->
                        <div class="col-12">
                            <div style="background:rgba(27,67,50,0.05); border:1px solid rgba(27,67,50,0.15);
                                        border-radius:10px; padding:12px 16px; font-size:0.8rem; color:#374151; line-height:1.7;">
                                <i class="bi bi-info-circle me-1" style="color:#1B4332;"></i>
                                <strong>How pricing works:</strong> Price is calculated per minute based on these rates.
                                Normal rate = ₹<span id="normal-per-min">0</span>/min &nbsp;|&nbsp;
                                Peak rate = ₹<span id="peak-per-min">0</span>/min.<br>
                                If a booking spans both normal and peak hours, each segment is priced separately and totalled.
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 4: Payment ─────────────────── -->
        <div class="col-12">
            <div class="settings-card">
                <div class="settings-card-header">
                    <i class="bi bi-cash-stack"></i>
                    Payment Configuration
                </div>
                <div class="settings-card-body">
                    <div class="row g-3">

                        <div class="col-12 col-md-4">
                            <label class="s-label">Advance Payment Deadline (hours)</label>
                            <input type="number" name="advance_payment_hours"
                                value="<%= settings.advance_payment_hours || '' %>"
                                placeholder="e.g. 24"
                                min="1" max="72"
                                class="s-input">
                            <small class="s-hint">
                                After approval, customer must pay within this many hours to confirm
                            </small>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- ── Section 5: Live Slot Preview ──────── -->
        <div class="col-12">
            <div class="settings-card">
                <div class="settings-card-header">
                    <i class="bi bi-calendar3"></i>
                    Live Slot Preview
                </div>
                <div class="settings-card-body">
                    <p class="s-divider">Slots generated from current values</p>
                    <div id="slot-preview-list" style="display:flex; flex-wrap:wrap; gap:10px;">
                        <!-- Rendered by JS -->
                    </div>
                    <div id="slot-preview-empty" style="display:none; font-size:0.8rem; color:#ADB5BD;">
                        Fill in open time, close time and slot duration to see preview
                    </div>
                </div>
            </div>
        </div>

        <!-- ── Warning ───────────────────────────── -->
        <div class="col-12">
            <div class="settings-warning">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    <strong>Heads up:</strong> Saving these settings applies to <strong>new bookings only</strong>. All confirmed bookings keep their original price and time — they are never affected by settings changes.
                </div>
            </div>
        </div>

        <!-- ── Save Button ────────────────────────── -->
        <div class="col-12 mb-4">
            <button type="submit" class="settings-save-btn">
                <i class="bi bi-floppy me-2"></i>SAVE SETTINGS
            </button>
        </div>

    </form>

</div>

<script>
const toMins = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
const toTime = m => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');

function calcPrice(startMins, endMins, normalRate, peakRate, peakStartMins, peakEndMins) {
    // Split booking at peak boundary and calculate each segment
    let normalMins = 0, peakMins = 0;
    let cur = startMins;
    while (cur < endMins) {
        const isPeak = peakStartMins !== null && peakEndMins !== null
            && cur >= peakStartMins && cur < peakEndMins;
        if (isPeak) peakMins++; else normalMins++;
        cur++;
    }
    const normalAmt = (normalMins / 30) * normalRate;
    const peakAmt   = (peakMins   / 30) * peakRate;
    return { total: normalAmt + peakAmt, normalMins, peakMins, normalAmt, peakAmt };
}

function updateRateDisplay() {
    const normalRate = parseFloat(document.querySelector('[name="normal_rate_per_30"]')?.value) || 0;
    const peakRate   = parseFloat(document.querySelector('[name="peak_rate_per_30"]')?.value)   || 0;
    const normalPerMin = document.getElementById('normal-per-min');
    const peakPerMin   = document.getElementById('peak-per-min');
    if (normalPerMin) normalPerMin.textContent = (normalRate / 30).toFixed(2);
    if (peakPerMin)   peakPerMin.textContent   = (peakRate   / 30).toFixed(2);
}

function updateSlotPreview() {
    const open       = document.querySelector('[name="open_time"]')?.value;
    const close      = document.querySelector('[name="close_time"]')?.value;
    const minSlot    = parseInt(document.querySelector('[name="min_slot_minutes"]')?.value) || 30;
    const peakStart  = document.querySelector('[name="peak_start_time"]')?.value;
    const peakEnd    = document.querySelector('[name="peak_end_time"]')?.value;
    const normalRate = parseFloat(document.querySelector('[name="normal_rate_per_30"]')?.value) || 0;
    const peakRate   = parseFloat(document.querySelector('[name="peak_rate_per_30"]')?.value)   || 0;

    const list  = document.getElementById('slot-preview-list');
    const empty = document.getElementById('slot-preview-empty');

    updateRateDisplay();

    if (!open || !close || !minSlot) {
        list.innerHTML = '';
        empty.style.display = 'block';
        return;
    }

    empty.style.display = 'none';

    const openM      = toMins(open);
    let   closeM     = toMins(close);
    if (closeM <= openM) closeM += 24 * 60; // overnight support
    const peakS      = peakStart ? toMins(peakStart) : null;
    const peakE      = peakEnd   ? toMins(peakEnd)   : null;

    // Preview shows example slots using minSlot as the duration
    // Real bookings can be any duration >= minSlot
    let html = '';
    let cur  = openM;
    let count = 0;
    const maxPreview = 20; // cap preview at 20 slots

    while (cur + minSlot <= closeM && count < maxPreview) {
        const end = cur + minSlot;
        const { total, normalMins, peakMins } = calcPrice(cur, end, normalRate, peakRate, peakS, peakE);
        const isPeak    = peakS !== null && peakE !== null && cur >= peakS && cur < peakE;
        const isMixed   = normalMins > 0 && peakMins > 0;
        const cls       = isMixed ? 'mixed' : isPeak ? 'peak' : 'off-peak';
        const tag       = isMixed ? 'Mixed' : isPeak ? 'Peak' : 'Normal';

        html += `<div class="slot-preview-item ${cls}">
                    <span class="slot-preview-time">${toTime(cur % (24*60))} – ${toTime(end % (24*60))}</span>
                    <span class="slot-preview-price">₹${Math.round(total)}</span>
                    <span class="slot-preview-tag">${tag}</span>
                 </div>`;
        cur += minSlot;
        count++;
    }

    if (count === maxPreview && cur + minSlot <= closeM) {
        html += `<div style="font-size:0.75rem;color:#6B7280;align-self:center;padding:6px 10px;">
                    + more slots (showing first ${maxPreview})
                 </div>`;
    }

    list.innerHTML = html || '<span style="font-size:0.8rem;color:#D90429;">No slots — check open/close times or minimum duration</span>';
}

['open_time','close_time','min_slot_minutes','peak_start_time','peak_end_time','normal_rate_per_30','peak_rate_per_30']
    .forEach(n => {
        const el = document.querySelector(`[name="${n}"]`);
        if (el) el.addEventListener('input', updateSlotPreview);
    });

document.addEventListener('DOMContentLoaded', updateSlotPreview);
</script>

<%- include('../partials/footer') %>
