<%- include('../partials/header') %>

<div class="row">

   <!-- Page Header -->
<div class="col-12 mb-4">
    <div class="bk-page-header">
        <div class="bk-page-header__left">
            <div class="bk-page-header__icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div>
                <h4 class="bk-page-header__title">Booking History</h4>
                <span class="bk-page-header__sub">All past and current bookings</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a href="/bookings" class="bk-back-btn">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
            <button onclick="openQuickBook()" class="bk-quickbook-btn">
                <i class="bi bi-lightning-charge-fill me-2"></i>QUICK BOOK
            </button>
        </div>
    </div>
</div>

    <!-- Filters -->
    <div class="col-12 mb-3">
        <div class="card">
            <div class="card-header" style="font-family:'Rajdhani',sans-serif; letter-spacing:1px;">FILTERS</div>
            <div class="card-body py-2">
                <form method="GET" action="/bookings/history" id="filter-form" class="d-flex gap-2 flex-wrap align-items-end">

                    <!-- Search -->
                    <div style="flex:1; min-width:200px;">
                        <label style="font-size:0.7rem; color:#4a5568; text-transform:uppercase; letter-spacing:1px; display:block; margin-bottom:4px;">Search</label>
                        <div style="position:relative;">
                            <i class="bi bi-search" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#4a5568; font-size:0.8rem; pointer-events:none;"></i>
                            <input type="text" name="search" id="search-input"
                                placeholder="Customer name or phone..."
                                value="<%= filters.search || '' %>"
                                class="form-control form-control-sm"
                                style="background:#0f1b2d; border:1px solid #1e3a5f; color:#f0f0f0; padding-left:30px; min-width:200px;"
                                autocomplete="off">
                        </div>
                    </div>

                    <!-- From Date -->
                    <div>
                        <label style="font-size:0.7rem; color:#4a5568; text-transform:uppercase; letter-spacing:1px; display:block; margin-bottom:4px;">From Date</label>
                        <input type="date" name="date_from" value="<%= filters.date_from || '' %>"
                            class="form-control form-control-sm"
                            style="background:#0f1b2d; border:1px solid #1e3a5f; color:#f0f0f0; min-width:150px;">
                    </div>

                    <!-- To Date -->
                    <div>
                        <label style="font-size:0.7rem; color:#4a5568; text-transform:uppercase; letter-spacing:1px; display:block; margin-bottom:4px;">To Date</label>
                        <input type="date" name="date_to" value="<%= filters.date_to || '' %>"
                            class="form-control form-control-sm"
                            style="background:#0f1b2d; border:1px solid #1e3a5f; color:#f0f0f0; min-width:150px;">
                    </div>

                    <!-- Status -->
                    <div>
                        <label style="font-size:0.7rem; color:#4a5568; text-transform:uppercase; letter-spacing:1px; display:block; margin-bottom:4px;">Status</label>
                        <select name="status" class="form-select form-select-sm"
                            style="background:#0f1b2d; border:1px solid #1e3a5f; color:#f0f0f0; min-width:140px;">
                            <option value="">All Status</option>
                            <option value="confirmed" <%= filters.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                            <option value="pending"   <%= filters.status === 'pending'   ? 'selected' : '' %>>Pending</option>
                            <option value="approved"  <%= filters.status === 'approved'  ? 'selected' : '' %>>Approved</option>
                            <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                            <option value="rejected"  <%= filters.status === 'rejected'  ? 'selected' : '' %>>Rejected</option>
                            <option value="expired"   <%= filters.status === 'expired'   ? 'selected' : '' %>>Expired</option>
                        </select>
                    </div>

                    <!-- Buttons -->
                    <button type="submit" class="btn btn-sm"
                        style="background:rgba(0,102,255,0.15); border:1px solid rgba(0,102,255,0.3); color:#0066ff;">
                        <i class="bi bi-filter me-1"></i> Filter
                    </button>
                    <a href="/bookings/history" class="btn btn-sm"
                        style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#a0a8b8;">
                        Clear
                    </a>

                </form>

                <!-- Active filter tags -->
                <% if (filters.search || filters.date_from || filters.date_to || filters.status) { %>
                <div style="margin-top:10px; display:flex; gap:6px; flex-wrap:wrap; align-items:center;">
                    <span style="font-size:0.68rem; color:#4a5568; text-transform:uppercase; letter-spacing:1px;">Active:</span>
                    <% if (filters.search) { %>
                        <span style="background:rgba(0,102,255,0.1); border:1px solid rgba(0,102,255,0.2); color:#0066ff; font-size:0.72rem; padding:2px 10px; border-radius:20px;">
                            <i class="bi bi-search me-1"></i>"<%= filters.search %>"
                        </span>
                    <% } %>
                    <% if (filters.date_from) { %>
                        <span style="background:rgba(0,102,255,0.1); border:1px solid rgba(0,102,255,0.2); color:#0066ff; font-size:0.72rem; padding:2px 10px; border-radius:20px;">
                            <i class="bi bi-calendar me-1"></i>From: <%= filters.date_from %>
                        </span>
                    <% } %>
                    <% if (filters.date_to) { %>
                        <span style="background:rgba(0,102,255,0.1); border:1px solid rgba(0,102,255,0.2); color:#0066ff; font-size:0.72rem; padding:2px 10px; border-radius:20px;">
                            <i class="bi bi-calendar me-1"></i>To: <%= filters.date_to %>
                        </span>
                    <% } %>
                    <% if (filters.status) { %>
                        <span style="background:rgba(0,102,255,0.1); border:1px solid rgba(0,102,255,0.2); color:#0066ff; font-size:0.72rem; padding:2px 10px; border-radius:20px;">
                            <i class="bi bi-circle-fill me-1" style="font-size:0.5rem;"></i><%= filters.status %>
                        </span>
                    <% } %>
                </div>
                <% } %>

            </div>
        </div>
    </div>

    <!-- Summary Stats -->
<%
    const total     = bookings.length;
    const revenue   = bookings.filter(b => b.booking_status === 'confirmed').reduce((sum, b) => sum + parseFloat(b.advance_amount || 0), 0);
    const pending   = bookings.filter(b => ['pending','approved'].includes(b.booking_status)).length;
    const cancelled = bookings.filter(b => ['cancelled','rejected','expired'].includes(b.booking_status)).length;
%>
<div class="col-6 col-md-3 mb-4">
    <div class="bk-stat-card bk-stat-card--total">
        <div class="bk-stat-card__icon"><i class="bi bi-calendar3"></i></div>
        <div class="bk-stat-card__body">
            <div class="bk-stat-card__label">Total Bookings</div>
            <div class="bk-stat-card__value"><%= total %></div>
        </div>
    </div>
</div>
<div class="col-6 col-md-3 mb-4">
    <div class="bk-stat-card bk-stat-card--revenue">
        <div class="bk-stat-card__icon"><i class="bi bi-currency-rupee"></i></div>
        <div class="bk-stat-card__body">
            <div class="bk-stat-card__label">Revenue Collected</div>
            <div class="bk-stat-card__value bk-stat-card__value--sm">₹<%= revenue %></div>
        </div>
    </div>
</div>
<div class="col-6 col-md-3 mb-4">
    <div class="bk-stat-card bk-stat-card--pending">
        <div class="bk-stat-card__icon"><i class="bi bi-hourglass-split"></i></div>
        <div class="bk-stat-card__body">
            <div class="bk-stat-card__label">Pending</div>
            <div class="bk-stat-card__value"><%= pending %></div>
        </div>
    </div>
</div>
<div class="col-6 col-md-3 mb-4">
    <div class="bk-stat-card bk-stat-card--cancelled">
        <div class="bk-stat-card__icon"><i class="bi bi-x-circle"></i></div>
        <div class="bk-stat-card__body">
            <div class="bk-stat-card__label">Cancelled</div>
            <div class="bk-stat-card__value"><%= cancelled %></div>
        </div>
    </div>
</div>

    <!-- History Table -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center"
                style="font-family:'Rajdhani',sans-serif; letter-spacing:1px;">
                <span>HISTORY</span>
                <small style="color:#4a5568;"><%= bookings.length %> records</small>
            </div>
            <div class="card-body p-0">
                <% if (bookings.length === 0) { %>
                    <div class="text-center py-5" style="color:#4a5568;">
                        <i class="bi bi-calendar-x" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0">No bookings found</p>
                        <% if (filters.search || filters.date_from || filters.date_to || filters.status) { %>
                            <a href="/bookings/history" style="font-size:0.8rem; color:#0066ff; display:block; margin-top:8px;">Clear all filters</a>
                        <% } %>
                    </div>
                <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover mb-0" style="font-size:0.82rem;">
                        <thead>
                            <tr style="border-bottom:1px solid #1e3a5f;">
                                <th style="color:#4a5568; font-weight:500; padding:12px 16px;">Booking No.</th>
                                <th style="color:#4a5568; font-weight:500;">Customer</th>
                                <th style="color:#4a5568; font-weight:500;">Phone</th>
                                <th style="color:#4a5568; font-weight:500;">Date</th>
                                <th style="color:#4a5568; font-weight:500;">Slot</th>
                                <th style="color:#4a5568; font-weight:500;">Total</th>
                                <th style="color:#4a5568; font-weight:500;">Paid</th>
                                <th style="color:#4a5568; font-weight:500;">Balance</th>
                                <th style="color:#4a5568; font-weight:500;">Status</th>
                                <th style="color:#4a5568; font-weight:500;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% bookings.forEach(b => { %>
                            <tr style="border-bottom:1px solid rgba(30,58,95,0.5);">
                                <td style="padding:12px 16px; color:#0066ff; font-weight:600;"><%= b.booking_no %></td>
                                <td style="color:#f0f0f0;"><%= b.customer_name %></td>
                                <td style="color:#a0a8b8;"><%= b.customer_phone %></td>
                                <td style="color:#a0a8b8;">
                                    <%= new Date(b.slot_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short'}) %>
                                </td>
                                <td style="color:#a0a8b8;">
                                    <%= b.start_time.slice(0,5) %> - <%= b.end_time.slice(0,5) %>
                                </td>
                                <td style="color:#f0f0f0;">₹<%= b.total_amount %></td>
                                <td style="color:#39ff14;">₹<%= b.advance_amount %></td>
                                <td style="color:<%= b.balance_amount > 0 ? '#ff4d6d' : '#39ff14' %>;">
                                    ₹<%= b.balance_amount %>
                                </td>
                                <td>
                                    <% if (b.booking_status === 'confirmed') { %>
                                        <span class="badge" style="background:rgba(57,255,20,0.12); color:#39ff14; border:1px solid rgba(57,255,20,0.2);">Confirmed</span>
                                    <% } else if (b.booking_status === 'pending') { %>
                                        <span class="badge" style="background:rgba(245,158,11,0.12); color:#f59e0b; border:1px solid rgba(245,158,11,0.2);">Pending</span>
                                    <% } else if (b.booking_status === 'approved') { %>
                                        <span class="badge" style="background:rgba(0,102,255,0.12); color:#0066ff; border:1px solid rgba(0,102,255,0.2);">Approved</span>
                                    <% } else if (b.booking_status === 'completed') { %>
                                        <span class="badge" style="background:rgba(100,100,100,0.12); color:#a0a8b8; border:1px solid rgba(100,100,100,0.2);">Completed</span>
                                    <% } else if (b.booking_status === 'cancelled') { %>
                                        <span class="badge" style="background:rgba(255,77,109,0.12); color:#ff4d6d; border:1px solid rgba(255,77,109,0.2);">Cancelled</span>
                                    <% } else { %>
                                        <span class="badge" style="background:rgba(100,100,100,0.12); color:#a0a8b8; border:1px solid rgba(100,100,100,0.2);"><%= b.booking_status %></span>
                                    <% } %>
                                </td>
                                <td>
                                    <a href="/bookings/<%= b.id %>" class="btn btn-sm"
                                        style="background:rgba(0,102,255,0.1); border:1px solid rgba(0,102,255,0.2); color:#0066ff; font-size:0.72rem;">
                                        View
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
                <% } %>
            </div>
        </div>
    </div>

</div>

<!-- Auto submit on date/status change -->
<script>
document.querySelector('select[name="status"]').addEventListener('change', () => {
    document.getElementById('filter-form').submit();
});
document.querySelector('input[name="date_from"]').addEventListener('change', () => {
    document.getElementById('filter-form').submit();
});
document.querySelector('input[name="date_to"]').addEventListener('change', () => {
    document.getElementById('filter-form').submit();
});
</script>

<%- include('../partials/quickbook-drawer') %>

<%- include('../partials/footer') %>
