    const win = window.open('', '_blank', 'width=900,height=700');
    win.document.write(`
        <!DOCTYPE html>
        <html>
        <head>
            <meta charset="UTF-8">
            <title>Invoice - <%= group.bulk_booking_id %></title>
            <style>
                @page { size: A4 portrait; margin: 0; }
