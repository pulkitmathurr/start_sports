                .inv-table { width: 100%; border-collapse: collapse; margin-bottom: 16px; font-size: 0.82rem; }
                .inv-table thead tr { background: #2563eb; color: #fff; }
                .inv-table th { padding: 9px 12px; font-weight: 600; font-size: 0.75rem; letter-spacing: 0.5px; }
                .inv-table tbody tr { border-bottom: 1px solid #e5e7eb; }
                .inv-table tbody tr:last-child { border-bottom: 2px solid #2563eb; }
