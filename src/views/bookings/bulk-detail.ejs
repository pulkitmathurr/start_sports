async function confirmCancel(id, bookingNo) {
    showDelModal({
        title: 'Cancel Booking',
        message: `Cancel booking <strong>${bookingNo}</strong>? This cannot be undone.`,
        confirmText: 'Yes, Cancel', cancelText: 'Keep Booking',
        icon: 'bi bi-x-circle-fill', iconClass: 'del-modal__icon--warn', confirmClass: 'warn'
    }, async () => {
        try {
            const res = await fetch('/bookings/cancel', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({booking_id:id}) });
            const data = await res.json();
            if (data.success) window.location.reload();
            else xToast(data.message || 'Failed to cancel booking', 'error');
        } catch(e) { xToast('Connection error. Please try again.', 'error'); }
    });
}

async function confirmDelete(id, bookingNo) {
    showDelModal({
        title: 'Delete Booking',
        message: `Delete booking <strong>${bookingNo}</strong>?<br><small style="color:#9ca3af;">Booking must be cancelled before it can be deleted.</small>`,
        confirmText: 'Delete', cancelText: 'Cancel',
        icon: 'bi bi-trash3-fill', iconClass: 'del-modal__icon--danger', confirmClass: ''
    }, async () => {
        try {
            const res = await fetch('/bookings/delete', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({booking_id:id}) });
            const data = await res.json();
            if (data.success) window.location.reload();
            else xToast(data.message || 'Failed to delete booking', 'error');
        } catch(e) { xToast('Connection error. Please try again.', 'error'); }
    });
}

function openBulkPayment() {
    document.getElementById('bulk-pay-overlay').style.display = 'block';
    document.getElementById('bulk-pay-drawer').style.display  = 'flex';
    document.getElementById('bulk-pay-amount').value = '';
    document.getElementById('bulk-pay-msg').style.display = 'none';
}
function closeBulkPayment() {
    document.getElementById('bulk-pay-overlay').style.display = 'none';
    document.getElementById('bulk-pay-drawer').style.display  = 'none';
}

async function submitBulkPayment() {
    const amount       = parseFloat(document.getElementById('bulk-pay-amount').value);
    const payment_mode = document.getElementById('bulk-pay-mode').value;
    const msgEl        = document.getElementById('bulk-pay-msg');
    const btn          = document.getElementById('bulk-pay-btn');

    if (!amount || amount <= 0) { showMsg('Enter a valid amount', false); return; }

    btn.disabled = true;
    btn.textContent = 'Processing...';

    try {
        const csrf = (document.cookie.match(/(?:^|; )csrf_token=([^;]*)/) || [])[1] || '';
        const res  = await fetch('/bookings/bulk/payment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': decodeURIComponent(csrf) },
            body: JSON.stringify({ bulk_booking_id: '<%= group.bulk_booking_id %>', amount, payment_mode })
        });
        const data = await res.json();
        if (data.success) {
            showMsg('Payment recorded successfully!', true);
            setTimeout(() => window.location.reload(), 1200);
        } else {
            showMsg(data.message || 'Failed to record payment', false);
            btn.disabled = false;
            btn.textContent = 'Confirm Payment';
        }
    } catch (e) {
        showMsg('Connection error', false);
        btn.disabled = false;
        btn.textContent = 'Confirm Payment';
    }
}

function showMsg(msg, success) {
    const el = document.getElementById('bulk-pay-msg');
    el.style.display = 'block';
    el.style.background = success ? '#ecfdf5' : '#fef2f2';
    el.style.border = `1px solid ${success ? '#a7f3d0' : '#fecaca'}`;
    el.style.color  = success ? '#065f46' : '#991b1b';
    el.textContent  = msg;
}
</script>

