                .inv-header__logo img { width: 90px; height: 90px; object-fit: contain; }
                .inv-header__name { font-size: 1.2rem; font-weight: 800; color: #1e293b; letter-spacing: 0.5px; }
                .inv-header__addr { font-size: 0.78rem; color: #6b7280; margin-top: 2px; }
                .inv-header__right { text-align: right; }
                .inv-header__title { font-size: 1.8rem; font-weight: 900; color: #1e293b; letter-spacing: 3px; }
                .inv-header__no { font-size: 0.85rem; color: #374151; font-weight: 600; margin-top: 2px; }
                .inv-header__date { font-size: 0.78rem; color: #6b7280; margin-top: 2px; }
                .inv-status-badge { display: inline-block; margin-top: 6px; padding: 2px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; letter-spacing: 1px; }
                .inv-status--confirmed { background: #dbeafe; color: #1e40af; border: 1px solid #bfdbfe; }
                .inv-divider { height: 2px; background: linear-gradient(90deg, #2563eb, #60a5fa, #2563eb); margin: 10px 0 16px; border-radius: 2px; }
                .inv-meta { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 20px; padding: 14px 16px; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 8px; }
                .inv-meta__box { flex: 1; }
                .inv-meta__box--right { text-align: right; }
                .inv-meta__title { font-size: 0.65rem; font-weight: 700; color: #9ca3af; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 6px; }
                .inv-meta__val { font-size: 0.82rem; color: #374151; margin-bottom: 2px; }
                .inv-meta__val--lg { font-size: 1rem; font-weight: 700; color: #111; }
                .inv-meta__val--green { color: #2563eb; font-weight: 700; }
                .inv-meta__row { display: flex; justify-content: flex-end; gap: 10px; font-size: 0.8rem; margin-bottom: 3px; }
