<%- include('../partials/header') %>

    <div class="row">

        <!-- Page Header -->
        <div class="col-12 mb-3">
            <div class="booking-header">
                <div class="booking-header__left">
                    <div class="booking-header__icon">
                        <i class="bi bi-receipt"></i>
                    </div>
                    <div>
                        <h4 class="booking-header__title">
                            <%= booking.booking_no %>
                        </h4>
                        <span class="booking-header__sub">Booking Detail</span>
                    </div>
                </div>
                <a href="/bookings" class="booking-back-btn" onclick="event.preventDefault(); window.location.replace('/bookings');">
                    <i class="bi bi-arrow-left me-1"></i> Back to Bookings
                </a>
            </div>
        </div>

        <!-- Left — Booking Info -->
        <div class="col-12 col-lg-7">
            <div class="booking-card mb-3">
                <div class="booking-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-info-circle me-2"></i>BOOKING DETAILS</span>
                    <% let statusBg, statusColor; 
                       if (booking.booking_status==='confirmed' ) {
                           statusBg='#dbeafe'; statusColor='#1e40af'; 
                       } else if (booking.booking_status==='pending' ) { 
                           statusBg='#fef3c7'; statusColor='#92400e'; 
                       } else if (booking.booking_status==='approved' ) { 
                           statusBg='#dbeafe'; statusColor='#2563eb'; 
                       } else { 
                           statusBg='#fee2e2'; statusColor='#991b1b'; 
                       } %>
                    <span class="booking-status-badge" style="background:<%= statusBg %>; color:<%= statusColor %>;">
                        <i class="bi bi-<%= booking.booking_status === 'confirmed' ? 'check-circle-fill' : (booking.booking_status === 'pending' ? 'clock-fill' : (booking.booking_status === 'approved' ? 'check-circle' : 'x-circle-fill')) %> me-1"></i>
                        <%= booking.booking_status.toUpperCase() %>
                    </span>
                </div>
                <div class="booking-card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="booking-info-label">Customer Name</div>
                            <div class="booking-info-value"><%= booking.customer_name %></div>
                        </div>
                        <div class="col-6">
                            <div class="booking-info-label">Phone</div>
                            <div class="booking-info-value"><%= booking.customer_phone %></div>
                        </div>
                        <div class="col-6">
                            <div class="booking-info-label">Email</div>
                            <div class="booking-info-value"><%= booking.customer_email || '—' %></div>
                        </div>
                        <div class="col-6">
                            <div class="booking-info-label">Booking Type</div>
                            <div class="booking-info-value"><%= booking.booking_type %></div>
                        </div>
                        <div class="col-6">
                            <div class="booking-info-label">Slot Date</div>
                            <div class="booking-info-value">
                                <%= new Date(booking.slot_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="booking-info-label">Time Slot</div>
                            <div class="booking-info-value booking-time-slot">
                                <%= booking.start_time.slice(0,5) %> — <%= booking.end_time.slice(0,5) %>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="booking-info-label">Total Amount</div>
                            <div class="booking-amount booking-total">₹<%= booking.total_amount %></div>
                        </div>
                        <div class="col-4">
                            <div class="booking-info-label">Paid</div>
                            <div class="booking-amount booking-paid">₹<%= booking.advance_amount %></div>
                        </div>
                        <div class="col-4">
                            <div class="booking-info-label">Balance</div>
                            <div class="booking-amount <%= booking.balance_amount > 0 ? 'booking-balance-due' : 'booking-balance-zero' %>">
                                ₹<%= booking.balance_amount %>
                            </div>
                        </div>
                        <% if (booking.notes) { %>
                            <div class="col-12">
                                <div class="booking-info-label">Notes</div>
                                <div class="booking-info-note"><%= booking.notes %></div>
                            </div>
                        <% } %>
                        <% if (booking.rejection_reason) { %>
                            <div class="col-12">
                                <div class="booking-info-label booking-label-warning">Rejection Reason</div>
                                <div class="booking-info-note booking-warning-text"><%= booking.rejection_reason %></div>
                            </div>
                        <% } %>
                        <% if (booking.approval_expires_at && booking.booking_status==='approved' ) { %>
                            <div class="col-12">
                                <div class="booking-deadline-box">
                                    <i class="bi bi-hourglass-split me-1"></i>
                                    Payment Deadline: <%= new Date(booking.approval_expires_at).toLocaleString('en-IN') %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex gap-2 flex-wrap mb-3">

                <% if (booking.booking_status==='pending' ) { %>
                    <button onclick="approveBooking(<%= booking.id %>)" class="booking-action-btn booking-action-approve">
                        <i class="bi bi-check-circle me-1"></i> APPROVE
                    </button>
                    <button onclick="showRejectModal(<%= booking.id %>)" class="booking-action-btn booking-action-reject">
                        <i class="bi bi-x-circle me-1"></i> REJECT
                    </button>
                <% } %>

                <% if (['confirmed','approved'].includes(booking.booking_status)) { %>
                    <button onclick="cancelBooking(<%= booking.id %>)" class="booking-action-btn booking-action-cancel">
                        <i class="bi bi-x-lg me-1"></i> CANCEL BOOKING
                    </button>
                <% } %>

                <% if (booking.booking_status==='confirmed' ) { %>
                    <button onclick="printInvoice()" class="booking-action-btn booking-action-print">
                        <i class="bi bi-printer me-1"></i> PRINT INVOICE
                    </button>
                <% } %>

            </div>

            <!-- Error/Success message -->
            <div id="action-msg" style="display:none;" class="alert mb-3"></div>

        </div>

        <!-- Right — Payments -->
        <div class="col-12 col-lg-5">

            <!-- Payment History -->
            <div class="booking-card mb-3">
                <div class="booking-card-header">
                    <i class="bi bi-credit-card me-2"></i>PAYMENT HISTORY
                </div>
                <div class="booking-card-body p-0">
                    <% if (payments.length===0) { %>
                        <div class="text-center py-4 payment-empty">
                            <i class="bi bi-receipt me-1"></i> No payments recorded yet
                        </div>
                    <% } else { %>
                        <div class="table-responsive">
                            <table class="payment-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Mode</th>
                                        <th>Type</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% payments.forEach(p=> { %>
                                        <tr>
                                            <td><%= new Date(p.payment_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short'}) %></td>
                                            <td class="payment-amount">₹<%= p.amount %></td>
                                            <td><span class="payment-mode-badge payment-mode-<%= p.payment_mode %>"><%= p.payment_mode %></span></td>
                                            <td><%= p.payment_type %></td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Add Payment -->
            <% if (booking.booking_status==='approved' || (booking.booking_status==='confirmed' && booking.balance_amount> 0)) { %>
                <div class="booking-card" id="payment-section">
                    <div class="booking-card-header">
                        <i class="bi bi-cash-stack me-2"></i>RECORD PAYMENT
                    </div>
                    <div class="booking-card-body">
                        <div class="mb-3">
                            <label class="payment-label">Amount *</label>
                            <input type="number" id="pay-amount" placeholder="Enter amount"
                                value="<%= booking.balance_amount %>" class="payment-input">
                        </div>
                        <div class="mb-3">
                            <label class="payment-label">Payment Mode *</label>
                            <select id="pay-mode" class="payment-select">
                                <option value="cash">Cash</option>
                                <option value="upi">UPI</option>
                                <option value="card">Card</option>
                                <option value="bank">Bank Transfer</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="payment-label">Payment Type *</label>
                            <select id="pay-type" class="payment-select">
                                <option value="advance">Advance</option>
                                <option value="balance">Balance</option>
                                <option value="full">Full</option>
                            </select>
                        </div>
                        <button onclick="recordPayment(<%= booking.id %>)" class="payment-submit-btn">
                            <i class="bi bi-check-circle me-2"></i> RECORD PAYMENT
                        </button>
                    </div>
                </div>
            <% } %>

        </div>
    </div>

    <!-- Reject Modal -->
    <div id="reject-modal" class="reject-modal">
        <div class="reject-modal-content">
            <div class="reject-modal-header">
                <i class="bi bi-x-circle-fill me-2"></i> REJECT BOOKING
            </div>
            <div class="reject-modal-body">
                <label class="reject-modal-label">Reason *</label>
                <textarea id="reject-reason" rows="3" placeholder="Enter rejection reason..." class="reject-modal-textarea"></textarea>
            </div>
            <div class="reject-modal-footer">
                <button onclick="closeRejectModal()" class="reject-modal-btn reject-modal-cancel">Cancel</button>
                <button onclick="submitReject()" class="reject-modal-btn reject-modal-confirm">REJECT</button>
            </div>
        </div>
    </div>

    <%- include('../partials/quickbook-drawer') %>

    <!-- ══ INVOICE (hidden, print only) ══════════════ -->
    <div id="invoice-print" style="display:none;">
        <div class="inv-page">

            <!-- Header -->
            <div class="inv-header">
                <div class="inv-header__brand">
                    <div class="inv-header__logo">
                        <img src="/images/startSportLogo1.png" alt="Logo" onerror="this.style.display='none'">
                    </div>
                    <div>
                        <div class="inv-header__name"><%= settings && settings.ground_name ? settings.ground_name : 'Start Sports' %></div>
                        <% if (settings && settings.ground_address) { %>
                            <div class="inv-header__addr"><%= settings.ground_address %></div>
                        <% } %>
                        <% if (settings && settings.ground_phone) { %>
                            <div class="inv-header__addr">Ph: <%= settings.ground_phone %></div>
                        <% } %>
                        <% if (settings && settings.ground_email) { %>
                            <div class="inv-header__addr"><%= settings.ground_email %></div>
                        <% } %>
                    </div>
                </div>
                <div class="inv-header__right">
                    <div class="inv-header__title">INVOICE</div>
                    <div class="inv-header__no"># <%= booking.booking_no %></div>
                    <div class="inv-header__date">Date: <%= new Date().toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></div>
                    <div class="inv-status-badge <%= booking.booking_status === 'confirmed' ? 'inv-status--confirmed' : 'inv-status--other' %>">
                        <%= booking.booking_status.toUpperCase() %>
                    </div>
                </div>
            </div>

            <div class="inv-divider"></div>

            <!-- Bill To + Booking Info -->
            <div class="inv-meta">
                <div class="inv-meta__box">
                    <div class="inv-meta__title">BILLED TO</div>
                    <div class="inv-meta__val inv-meta__val--lg"><%= booking.customer_name %></div>
                    <div class="inv-meta__val">Ph: <%= booking.customer_phone %></div>
                    <% if (booking.customer_email) { %>
                        <div class="inv-meta__val"><%= booking.customer_email %></div>
                    <% } %>
                </div>
                <div class="inv-meta__box inv-meta__box--right">
                    <div class="inv-meta__title">BOOKING INFO</div>
                    <div class="inv-meta__row">
                        <span class="inv-meta__key">Booking No.</span>
                        <span class="inv-meta__val inv-meta__val--green"><%= booking.booking_no %></span>
                    </div>
                    <div class="inv-meta__row">
                        <span class="inv-meta__key">Booking Type</span>
                        <span class="inv-meta__val" style="text-transform:capitalize;"><%= booking.booking_type %></span>
                    </div>
                    <% if (booking.ground_name) { %>
                        <div class="inv-meta__row">
                            <span class="inv-meta__key">Ground</span>
                            <span class="inv-meta__val"><%= booking.ground_name %></span>
                        </div>
                    <% } %>
                    <div class="inv-meta__row">
                        <span class="inv-meta__key">Slot Date</span>
                        <span class="inv-meta__val"><%= new Date(booking.slot_date + 'T00:00:00').toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></span>
                    </div>
                    <div class="inv-meta__row">
                        <span class="inv-meta__key">Time</span>
                        <span class="inv-meta__val"><%= booking.start_time.slice(0,5) %> – <%= booking.end_time.slice(0,5) %></span>
                    </div>
                    <div class="inv-meta__row">
                        <span class="inv-meta__key">Payment Mode</span>
                        <span class="inv-meta__val" style="text-transform:capitalize;"><%= booking.payment_mode || '—' %></span>
                    </div>
                </div>
            </div>

            <!-- Slot Details Table -->
            <table class="inv-table">
                <thead>
                    <tr>
                        <th style="width:40%;">Description</th>
                        <th style="text-align:center;">Date</th>
                        <th style="text-align:center;">Time Slot</th>
                        <th style="text-align:right;">Original Price</th>
                        <th style="text-align:right;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            <strong>Ground Booking</strong>
                            <% if (booking.ground_name) { %>
                                <br><span style="font-size:0.78rem; color:#6b7280;"><%= booking.ground_name %></span>
                            <% } %>
                            <% if (booking.notes) { %>
                                <br><span style="font-size:0.75rem; color:#9ca3af;">Note: <%= booking.notes %></span>
                            <% } %>
                            <% if (booking.pricing_note) { %>
                                <br><span style="font-size:0.72rem; color:#6b7280; font-style:italic;"><%= booking.pricing_note %></span>
                            <% } %>
                        </td>
                        <td style="text-align:center;">
                            <%= new Date(booking.slot_date + 'T00:00:00').toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %>
                        </td>
                        <td style="text-align:center; font-weight:700; color:#2563eb;">
                            <%= booking.start_time.slice(0,5) %> – <%= booking.end_time.slice(0,5) %>
                        </td>
                        <td style="text-align:right; color:#6b7280;">
                            ₹<%= Number(booking.original_amount || booking.total_amount).toLocaleString('en-IN') %>
                        </td>
                        <td style="text-align:right; font-weight:700;">
                            ₹<%= Number(booking.total_amount).toLocaleString('en-IN') %>
                        </td>
                    </tr>
                </tbody>
            </table>

            <!-- Payment Summary -->
            <div class="inv-summary">
                <% if (booking.original_amount && Number(booking.original_amount) !== Number(booking.total_amount)) { %>
                    <div class="inv-summary__row">
                        <span>Original Price</span>
                        <span>₹<%= Number(booking.original_amount).toLocaleString('en-IN') %></span>
                    </div>
                <% } %>
                <% if (booking.discount_amount && Number(booking.discount_amount) > 0) { %>
                    <div class="inv-summary__row" style="color:#059669;">
                        <span>Discount</span>
                        <span>– ₹<%= Number(booking.discount_amount).toLocaleString('en-IN') %></span>
                    </div>
                <% } %>
                <% if (booking.surcharge_amount && Number(booking.surcharge_amount) > 0) { %>
                    <div class="inv-summary__row" style="color:#d97706;">
                        <span>Surcharge</span>
                        <span>+ ₹<%= Number(booking.surcharge_amount).toLocaleString('en-IN') %></span>
                    </div>
                <% } %>
                <div class="inv-summary__row" style="font-weight:700;">
                    <span>Total Amount</span>
                    <span>₹<%= Number(booking.total_amount).toLocaleString('en-IN') %></span>
                </div>
                <div class="inv-summary__row inv-summary__row--paid">
                    <span>Amount Paid</span>
                    <span>₹<%= Number(booking.advance_amount).toLocaleString('en-IN') %></span>
                </div>
                <div class="inv-summary__divider"></div>
                <div class="inv-summary__row inv-summary__row--total">
                    <span>Balance Due</span>
                    <span style="color:<%= Number(booking.balance_amount) > 0 ? '#dc2626' : '#2563eb' %>;">
                        ₹<%= Number(booking.balance_amount).toLocaleString('en-IN') %>
                    </span>
                </div>
            </div>

            <!-- Payment History -->
            <% if (payments && payments.length > 0) { %>
                <div class="inv-payments">
                    <div class="inv-payments__title">PAYMENT HISTORY</div>
                    <table class="inv-pay-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Mode</th>
                                <th>Type</th>
                                <th style="text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach((p, i) => { %>
                                <tr>
                                    <td><%= i + 1 %></td>
                                    <td><%= new Date(p.payment_date).toLocaleDateString('en-IN', {day:'2-digit', month:'short', year:'numeric'}) %></td>
                                    <td style="text-transform:capitalize;"><%= p.payment_mode %></td>
                                    <td style="text-transform:capitalize;"><%= p.payment_type %></td>
                                    <td style="text-align:right; font-weight:600; color:#2563eb;">₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>

            <!-- Notes -->
            <% if (booking.notes) { %>
                <div style="margin-top:18px; padding:10px 14px; background:#f9fafb; border:1px solid #e5e7eb; border-radius:6px; font-size:0.82rem; color:#4b5563;">
                    <strong>Notes:</strong> <%= booking.notes %>
                </div>
            <% } %>

            <!-- Footer -->
            <div class="inv-footer">
                <div class="inv-footer__status">
                    <% if (Number(booking.balance_amount) <= 0) { %>
                        <span class="inv-footer__paid">✓ FULLY PAID</span>
                    <% } else { %>
                        <span class="inv-footer__pending">⚠ BALANCE DUE: ₹<%= Number(booking.balance_amount).toLocaleString('en-IN') %></span>
                    <% } %>
                </div>
                <div class="inv-footer__note">Thank you for your booking. Please present this invoice at the ground.</div>
                <div class="inv-footer__generated">Generated on <%= new Date().toLocaleString('en-IN') %></div>
            </div>

        </div>
    </div>

    <style>
    /* ═══════════════════════════════════════════════════════════════
       BOOKING DETAIL PAGE - Blue/White Theme
    ═══════════════════════════════════════════════════════════════ */

    /* Page Header */
    .booking-header {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 45%, #1e40af 100%);
        border-radius: 20px;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 24px rgba(37, 99, 235, 0.2);
    }

    .booking-header__left {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        z-index: 2;
    }

    .booking-header__icon {
        width: 46px;
        height: 46px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.25);
    }

    .booking-header__title {
        font-family: 'Rajdhani', sans-serif;
        font-size: 1.2rem;
        font-weight: 700;
        color: #fff;
        margin: 0;
        line-height: 1.3;
        letter-spacing: -0.3px;
    }

    .booking-header__sub {
        font-size: 0.68rem;
        color: rgba(255, 255, 255, 0.7);
        margin-top: 2px;
        display: block;
    }

    .booking-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        font-size: 0.72rem;
        font-weight: 600;
        padding: 7px 16px;
        border-radius: 10px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .booking-back-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateY(-1px);
        color: #fff;
    }

    /* Cards */
    .booking-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
    }

    .booking-card-header {
        padding: 12px 18px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 1px;
        color: #1e293b;
    }

    .booking-card-body {
        padding: 18px;
    }

    /* Info Labels */
    .booking-info-label {
        font-size: 0.62rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        margin-bottom: 4px;
    }

    .booking-info-value {
        font-size: 0.85rem;
        color: #1e293b;
        font-weight: 500;
    }

    .booking-time-slot {
        color: #2563eb;
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
    }

    .booking-amount {
        font-family: 'Rajdhani', sans-serif;
        font-weight: 700;
        font-size: 1rem;
    }

    .booking-total {
        color: #1e293b;
    }

    .booking-paid {
        color: #059669;
    }

    .booking-balance-due {
        color: #dc2626;
    }

    .booking-balance-zero {
        color: #059669;
    }

    .booking-info-note {
        font-size: 0.78rem;
        color: #64748b;
        background: #f8fafc;
        padding: 8px 12px;
        border-radius: 10px;
    }

    .booking-label-warning {
        color: #dc2626;
    }

    .booking-warning-text {
        color: #991b1b;
    }

    .booking-deadline-box {
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 10px;
        padding: 10px;
        font-size: 0.78rem;
        color: #92400e;
        font-weight: 600;
    }

    /* Status Badge */
    .booking-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    /* Action Buttons */
    .booking-action-btn {
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 0.72rem;
        font-weight: 700;
        font-family: 'Rajdhani', sans-serif;
